@model TallerMecanicoSantoDomingo.ViewModels.VehiculoFormViewModel
@{
    ViewData["Title"] = "Registrar vehículo";
    var clientes = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Clientes;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-car-front me-2"></i>Registrar vehículo</h1>
        <div class="ruta"><a asp-action="Index">Vehículos</a> / Nuevo registro</div>
    </div>
</div>

<div class="tarjeta" style="max-width:720px">
    <form asp-action="Crear" method="post" class="formulario">
        <div asp-validation-summary="ModelOnly" class="alerta-error"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="IdCliente" class="form-label"></label>
                <select asp-for="IdCliente" class="form-select" asp-items="clientes">
                    <option value="">— Seleccione el cliente propietario —</option>
                </select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
                <div class="form-text">El vehículo debe pertenecer a un cliente registrado (Regla 2).</div>
            </div>
            <div class="col-md-4">
                <label asp-for="Placa" class="form-label"></label>
                <input asp-for="Placa" class="form-control text-uppercase" placeholder="M" style="text-transform:uppercase" />
                <span asp-validation-for="Placa" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Marca" class="form-label"></label>
                <input asp-for="Marca" class="form-control" placeholder="Toyota" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Modelo" class="form-label"></label>
                <input asp-for="Modelo" class="form-control" placeholder="Corolla" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Anio" class="form-label"></label>
                <input asp-for="Anio" class="form-control" type="number" min="1950" max="2100" />
                <span asp-validation-for="Anio" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-naranja"><i class="bi bi-save me-1"></i> Guardar vehículo</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidacionScripts" />
}
