@model TallerMecanicoSantoDomingo.Models.Servicio
@{
    ViewData["Title"] = $"Servicio #{Model.IdServicio}";
    var asignaciones = (List<TallerMecanicoSantoDomingo.Services.ItemAsignacion>)ViewBag.Asignaciones;
    var compatibles = (List<TallerMecanicoSantoDomingo.Services.TrabajadorCarga>)ViewBag.TrabajadoresCompatibles;
    var productosDisponibles = (List<TallerMecanicoSantoDomingo.Models.Producto>)null;
    bool abierto = Model.Estado == "Abierto";
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-gear-wide-connected me-2"></i>Servicio #@Model.IdServicio</h1>
        <div class="ruta"><a asp-action="Index">Servicios</a> / Detalle del servicio</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (abierto)
        {
            <a asp-action="Editar" asp-route-id="@Model.IdServicio" class="btn btn-azul"><i class="bi bi-pencil me-1"></i> Editar</a>
        }
        <a asp-controller="Vehiculos" asp-action="Detalles" asp-route-id="@Model.IdVehiculo" class="btn btn-outline-secondary">
            <i class="bi bi-car-front me-1"></i> Ver vehículo
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Columna izquierda: datos del servicio -->
    <div class="col-lg-4">
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-card-text me-1"></i> Datos del servicio</h2>
            <dl class="row mb-0" style="font-size:.9rem">
                <dt class="col-5 texto-secundario">Vehículo</dt>
                <dd class="col-7 fw-semibold">@Model.Vehiculo?.Placa — @Model.Vehiculo?.Marca @Model.Vehiculo?.Modelo</dd>
                <dt class="col-5 texto-secundario">Propietario</dt>
                <dd class="col-7">@Model.Vehiculo?.Cliente?.NombreCompleto</dd>
                <dt class="col-5 texto-secundario">Tipo</dt>
                <dd class="col-7"><span class="estado tipo-@Model.TipoServicio.ToLowerInvariant()">@Model.TipoServicio</span></dd>
                <dt class="col-5 texto-secundario">Estado</dt>
                <dd class="col-7"><span class="estado estado-@Model.Estado.ToLowerInvariant()">@Model.Estado</span></dd>
                <dt class="col-5 texto-secundario">Inicio</dt>
                <dd class="col-7">@Model.FechaInicio.ToString("dd/MM/yyyy")</dd>
                <dt class="col-5 texto-secundario">Fin</dt>
                <dd class="col-7">@(Model.FechaFin?.ToString("dd/MM/yyyy") ?? "Pendiente")</dd>
                <dt class="col-5 texto-secundario">Monto</dt>
                <dd class="col-7 fw-semibold">C$ @Model.Total.ToString("N2")</dd>
            </dl>
            <div class="mt-3" style="font-size:.88rem"><strong>Descripción:</strong> @Model.Descripcion</div>
            @if (!string.IsNullOrEmpty(Model.DescripcionFalla))
            {
                <div class="mt-1" style="font-size:.88rem"><strong>Falla:</strong> @Model.DescripcionFalla</div>
            }
            @if (Model.TipoServicio == "Pintura")
            {
                @if (!string.IsNullOrEmpty(Model.TipoPintura))
                {
                    <div class="mt-1" style="font-size:.88rem"><strong>Tipo de pintura:</strong> @Model.TipoPintura</div>
                }
                @if (!string.IsNullOrEmpty(Model.Color))
                {
                    <div class="mt-1" style="font-size:.88rem"><strong>Color:</strong> @Model.Color</div>
                }
            }
        </div>

        @if (Model.DetalleFacturas.Any(df => df.Factura != null))
        {
            <div class="tarjeta">
                <h2 class="h6 fw-bold text-primary mb-2"><i class="bi bi-receipt me-1"></i> Facturación</h2>
                @foreach (var df in Model.DetalleFacturas.Where(df => df.Factura != null))
                {
                    <div class="d-flex justify-content-between align-items-center" style="font-size:.87rem">
                        <span>@df.Factura!.NumeroFactura <span class="estado estado-@df.Factura.Estado.ToLowerInvariant()">@df.Factura.Estado</span></span>
                        <a asp-controller="Facturas" asp-action="Imprimir" asp-route-id="@df.Factura.IdFactura" class="btn btn-sm btn-outline-primary btn-icono" title="Ver factura">
                            <i class="bi bi-printer"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Columna derecha: operación -->
    <div class="col-lg-8">
        <!-- Trabajadores asignados -->
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-person-badge me-1"></i> Trabajadores asignados</h2>

            @if (asignaciones.Count == 0)
            {
                <div class="estado-vacio py-3" id="zona-vacia-asignados">
                    <i class="bi bi-person-x"></i>
                    <div>Aún no hay trabajadores asignados a este servicio.</div>
                </div>
            }
            else
            {
                <div class="tabla-envuelta">
                    <table class="tabla-lista" id="tabla-asignados">
                        <thead>
                            <tr><th>Trabajador</th><th>Área</th><th>Asignado el</th><th>Estado</th><th class="acciones"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in asignaciones)
                            {
                                <tr>
                                    <td class="fw-semibold">@a.NombreTrabajador</td>
                                    <td>@a.Area</td>
                                    <td>@a.FechaAsignacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="estado estado-@a.EstadoAsignacion.ToLowerInvariant()">@a.EstadoAsignacion</span></td>
                                    <td class="acciones">
                                        @if (abierto && a.EstadoAsignacion == "Activo")
                                        {
                                            <form asp-controller="Asignaciones" asp-action="Desasignar" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idDetalleServicio" value="@a.IdDetalleServicio" />
                                                <input type="hidden" name="idServicio" value="@Model.IdServicio" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-icono" title="Retirar del servicio"
                                                        data-confirmar="¿Retirar a @a.NombreTrabajador de este servicio?">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (abierto)
            {
                <div class="mt-3">
                    <h3 class="fw-semibold text-primary" style="font-size:.88rem">Asignar trabajador compatible (Reglas 5, 6 y 7)</h3>
                    <form asp-controller="Asignaciones" asp-action="Asignar" method="post" class="row g-2 align-items-end" id="formulario-asignacion">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdServicio" value="@Model.IdServicio" />
                        <div class="col-md-7">
                            <label class="form-label" style="font-size:.83rem">Trabajadores del área: @Model.TipoServicio</label>
                            <select name="IdTrabajador" class="form-select" id="selector-trabajador" required>
                                <option value="">— Seleccione —</option>
                                @foreach (var t in compatibles)
                                {
                                    <option value="@t.IdTrabajador" data-activos="@t.ServiciosActivos" data-disponible="@t.Disponible">
                                        @t.NombreCompleto — @t.Area (@t.ServiciosActivos de 2 activos)
                                    </option>
                                }
                            </select>
                            <div class="form-text" id="aviso-carga"></div>
                        </div>
                        <div class="col-md-3">
                            <input name="Observaciones" class="form-control" placeholder="Observaciones (opcional)" maxlength="200" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-naranja w-100"><i class="bi bi-person-check me-1"></i> Asignar</button>
                        </div>
                    </form>
                    @if (compatibles.Count == 0)
                    {
                        <div class="alerta-info mt-2 mb-0" style="font-size:.85rem">
                            <i class="bi bi-info-circle me-1"></i>
                            No hay trabajadores compatibles disponibles. Verifique el área del servicio y la capacidad de los trabajadores (máximo 2 servicios activos, Regla 7).
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Productos utilizados -->
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-box-seam me-1"></i> Productos utilizados (repuestos y materiales)</h2>

            @if (!Model.ProductosUtilizados.Any())
            {
                <div class="estado-vacio py-3">
                    <i class="bi bi-box"></i>
                    <div>No se han registrado productos en este servicio.</div>
                </div>
            }
            else
            {
                <div class="tabla-envuelta">
                    <table class="tabla-lista">
                        <thead>
                            <tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Precio unit.</th><th class="text-end">Importe</th><th class="acciones"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var pu in Model.ProductosUtilizados.Where(pu => pu.Producto != null))
                            {
                                <tr>
                                    <td class="fw-semibold">@pu.Producto!.Nombre</td>
                                    <td class="text-end">@pu.Cantidad.ToString("0.###")</td>
                                    <td class="text-end">@pu.Producto.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-end">@(pu.Cantidad * pu.Producto.PrecioUnitario).ToString("N2")</td>
                                    <td class="acciones">
                                        @if (abierto)
                                        {
                                            <form asp-action="ActualizarProducto" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idProductoUtilizado" value="@pu.IdProductoUtilizado" />
                                                <input type="hidden" name="idServicio" value="@Model.IdServicio" />
                                                <input type="number" name="cantidad" value="@pu.Cantidad" step="0.001" min="0.001" class="form-control form-control-sm d-inline-block" style="width:100px" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary btn-icono" title="Actualizar cantidad"><i class="bi bi-check-lg"></i></button>
                                            </form>
                                            <form asp-action="QuitarProducto" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idProductoUtilizado" value="@pu.IdProductoUtilizado" />
                                                <input type="hidden" name="idServicio" value="@Model.IdServicio" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-icono" title="Quitar producto"
                                                        data-confirmar="¿Quitar @pu.Producto.Nombre de este servicio?">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (abierto)
            {
                <div class="mt-3">
                    <h3 class="fw-semibold text-primary" style="font-size:.88rem">Agregar producto al servicio (Reglas 9 y 10)</h3>
                    <form asp-action="AgregarProducto" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdServicio" value="@Model.IdServicio" />
                        <div class="col-md-7">
                            <select name="IdProducto" class="form-select" required>
                                <option value="">— Seleccione un producto activo —</option>
                                @foreach (var p in (List<TallerMecanicoSantoDomingo.Models.Producto>)ViewBag.ProductosActivos)
                                {
                                    <option value="@p.IdProducto">@p.Nombre — C$ @p.PrecioUnitario.ToString("N2") (stock: @p.Stock.ToString("0.###"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="number" name="Cantidad" class="form-control" step="0.001" min="0.001" value="1" placeholder="Cantidad" required />
                            <div class="form-text">La cantidad debe ser mayor que cero.</div>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-naranja w-100"><i class="bi bi-plus-lg me-1"></i> Agregar</button>
                        </div>
                    </form>
                </div>
            }
        </div>

        <!-- Estado del servicio -->
        @if (abierto)
        {
            <div class="tarjeta">
                <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-send-check me-1"></i> Cambiar estado del servicio</h2>
                <div class="row g-3">
                    <div class="col-md-7">
                        <form asp-action="Finalizar" method="post" class="formulario">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="IdServicio" value="@Model.IdServicio" />
                            <label class="form-label" style="font-size:.85rem">Finalizar (Regla 8: la fecha no puede ser anterior al inicio @Model.FechaInicio.ToString("dd/MM/yyyy"))</label>
                            <div class="input-group">
                                <input type="date" name="FechaFin" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                <button type="submit" class="btn btn-azul" data-confirmar="¿Finalizar este servicio? Se cerrarán sus asignaciones de personal.">
                                    <i class="bi bi-check2-circle me-1"></i> Finalizar
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-5">
                        <form asp-action="Cancelar" method="post" class="formulario">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="IdServicio" value="@Model.IdServicio" />
                            <label class="form-label" style="font-size:.85rem">Cancelar servicio</label>
                            <input type="text" name="Motivo" class="form-control mb-2" placeholder="Motivo (opcional)" maxlength="200" />
                            <button type="submit" class="btn btn-outline-danger w-100"
                                    data-confirmar="¿Cancelar este servicio? Los trabajadores quedarán disponibles.">
                                <i class="bi bi-x-circle me-1"></i> Cancelar servicio
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Aviso de capacidad del trabajador seleccionado (información consultada al servidor en el listado).
        (function () {
            const selector = document.getElementById('selector-trabajador');
            const aviso = document.getElementById('aviso-carga');
            if (!selector || !aviso) return;
            selector.addEventListener('change', function () {
                const opcion = selector.selectedOptions[0];
                if (!opcion || !opcion.value) { aviso.textContent = ''; return; }
                const activos = opcion.getAttribute('data-activos');
                const disponible = opcion.getAttribute('data-disponible') === 'True';
                if (!disponible) {
                    aviso.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Este trabajador ya tiene ' + activos + ' de 2 servicios activos; el servidor rechazará la asignación (Regla 7).</span>';
                } else {
                    aviso.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Carga actual: ' + activos + ' de 2 servicios activos.</span>';
                }
            });
        })();
    </script>
}
