@model TallerMecanicoSantoDomingo.Services.ResultadoPaginado<TallerMecanicoSantoDomingo.Models.Servicio>
@{
    ViewData["Title"] = "Servicios";
    var tipos = (IReadOnlyList<string>)ViewBag.Tipos;
    var estados = (IReadOnlyList<string>)ViewBag.Estados;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-gear-wide-connected me-2"></i>Servicios</h1>
        <div class="ruta">Mantenimientos mecánicos y trabajos de pintura</div>
    </div>
    <a asp-action="Crear" class="btn btn-naranja"><i class="bi bi-plus-lg me-1"></i> Registrar servicio</a>
</div>

<div class="tarjeta">
    <form asp-action="Index" method="get" data-busqueda class="row g-2 align-items-end mb-3">
        <input type="hidden" name="pagina" value="1" />
        <div class="col-md-4">
            <label class="form-label fw-semibold text-primary" style="font-size:.85rem">Buscar</label>
            <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Descripción, placa o cliente..." />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold text-primary" style="font-size:.85rem">Tipo</label>
            <select name="tipo" class="form-select">
                <option value="">Todos</option>
                @foreach (var t in tipos)
                {
                    <option value="@t" selected="@(ViewBag.Tipo as string == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold text-primary" style="font-size:.85rem">Estado</label>
            <select name="estado" class="form-select">
                <option value="">Todos</option>
                @foreach (var e in estados)
                {
                    <option value="@e" selected="@(ViewBag.Estado as string == e)">@e</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-azul w-100"><i class="bi bi-search me-1"></i> Filtrar</button>
        </div>
    </form>

    @if (Model.Elementos.Count == 0)
    {
        <div class="estado-vacio">
            <i class="bi bi-gear"></i>
            <div class="fw-semibold">No se encontraron servicios</div>
            <div style="font-size:.85rem">Registre un servicio o ajuste los filtros de búsqueda.</div>
        </div>
    }
    else
    {
        <div class="tabla-envuelta">
            <table class="tabla-lista">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Fecha inicio</th>
                        <th>Vehículo</th>
                        <th>Cliente</th>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Trabajadores</th>
                        <th class="text-end">Monto</th>
                        <th class="acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Elementos)
                    {
                        <tr>
                            <td class="fw-semibold">@s.IdServicio</td>
                            <td>@s.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="fw-semibold">@s.Vehiculo?.Placa</td>
                            <td>@s.Vehiculo?.Cliente?.NombreCompleto</td>
                            <td><span class="estado tipo-@s.TipoServicio.ToLowerInvariant()">@s.TipoServicio</span></td>
                            <td style="max-width:220px">@s.Descripcion</td>
                            <td><span class="estado estado-@s.Estado.ToLowerInvariant()">@s.Estado</span></td>
                            <td>@s.DetalleServicios.Count(d => d.Estado == "Activo")</td>
                            <td class="text-end">@s.Total.ToString("N2")</td>
                            <td class="acciones">
                                <a asp-action="Detalles" asp-route-id="@s.IdServicio" class="btn btn-sm btn-outline-primary btn-icono" title="Gestionar servicio">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (s.Estado == "Abierto")
                                {
                                    <a asp-action="Editar" asp-route-id="@s.IdServicio" class="btn btn-sm btn-outline-secondary btn-icono" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="texto-secundario" style="font-size:.83rem">
                    Página @Model.Pagina de @Model.TotalPaginas — @Model.TotalElementos registro(s)
                </span>
                <div class="paginacion">
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <a class="btn btn-sm @(p == Model.Pagina ? "actual" : "btn-outline-secondary")"
                           asp-action="Index" asp-route-pagina="@p" asp-route-buscar="@ViewBag.Buscar"
                           asp-route-tipo="@ViewBag.Tipo" asp-route-estado="@ViewBag.Estado">@p</a>
                    }
                </div>
            </nav>
        }
    }
</div>
