@model TallerMecanicoSantoDomingo.ViewModels.ConfiguracionInicialViewModel
@{
    ViewData["Title"] = "Configuración inicial";
    Layout = "_LayoutCuenta";
}
<div class="tarjeta-cuenta">
    <div class="marca-cuenta">
        <div class="escudo"><i class="bi bi-person-gear"></i></div>
        <h1>Primer administrador</h1>
        <div class="subtitulo">Esta página solo está disponible una vez, mientras no exista ningún usuario.</div>
    </div>

    <form asp-controller="Account" asp-action="ConfiguracionInicial" method="post" class="formulario">
        <div asp-validation-summary="ModelOnly" class="alerta-error mb-3"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autofocus autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <div class="input-group">
                <input asp-for="Password" class="form-control" id="campo-password" autocomplete="new-password" />
                <button class="btn btn-outline-secondary" type="button" data-ver-password="campo-password" title="Mostrar u ocultar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmarPassword" class="form-label"></label>
            <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-naranja w-100 py-2">
            <i class="bi bi-person-check me-1"></i> Crear administrador
        </button>
    </form>

    <div class="text-center mt-3">
        <a asp-controller="Account" asp-action="Login" class="texto-secundario" style="font-size:.85rem">Volver al inicio de sesión</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidacionScripts" />
}
