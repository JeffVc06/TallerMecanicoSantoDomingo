@{
    ViewData["Title"] = "Reporte de facturación";
    var desde = (DateOnly)ViewBag.Desde;
    var hasta = (DateOnly)ViewBag.Hasta;
    var facturas = ViewBag.Facturas as List<TallerMecanicoSantoDomingo.Services.FilaFacturaReporte> ?? new();
    var montos = ViewBag.Montos as List<TallerMecanicoSantoDomingo.Services.FilaMontoMensual> ?? new();
    var emitidas = facturas.Where(f => f.Estado == "Emitida").ToList();
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-receipt me-2"></i>Reporte de facturación</h1>
        <div class="ruta"><a asp-action="Index">Reportes</a> / Facturación por período</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-success" asp-action="ExportarCsv" asp-route-tipo="facturas"
           asp-route-desde="@desde.ToString("yyyy-MM-dd")" asp-route-hasta="@hasta.ToString("yyyy-MM-dd")">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
        </a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer me-1"></i> Imprimir</button>
    </div>
</div>

<div class="tarjeta">
    <form asp-action="Facturas" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label fw-semibold text-primary" style="font-size:.83rem">Desde</label>
            <input type="date" name="desde" value="@desde.ToString("yyyy-MM-dd")" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold text-primary" style="font-size:.83rem">Hasta</label>
            <input type="date" name="hasta" value="@hasta.ToString("yyyy-MM-dd")" class="form-control" required />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-azul w-100"><i class="bi bi-funnel me-1"></i> Aplicar período</button>
        </div>
    </form>

    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xl-3">
            <div class="border rounded p-3 h-100">
                <div class="texto-secundario" style="font-size:.8rem">FACTURAS EMITIDAS</div>
                <div class="fs-4 fw-bold text-primary">@emitidas.Count</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="border rounded p-3 h-100">
                <div class="texto-secundario" style="font-size:.8rem">SUBTOTAL (C$)</div>
                <div class="fs-4 fw-bold text-primary">@emitidas.Sum(f => f.Subtotal).ToString("N2")</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="border rounded p-3 h-100">
                <div class="texto-secundario" style="font-size:.8rem">IVA (C$)</div>
                <div class="fs-4 fw-bold text-primary">@emitidas.Sum(f => f.IVA).ToString("N2")</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="border rounded p-3 h-100">
                <div class="texto-secundario" style="font-size:.8rem">TOTAL FACTURADO (C$)</div>
                <div class="fs-4 fw-bold text-primary">@emitidas.Sum(f => f.Total).ToString("N2")</div>
            </div>
        </div>
    </div>

    @if (montos.Count > 0)
    {
        <h2 class="h6 fw-bold text-primary"><i class="bi bi-bar-chart me-1"></i> Resumen por mes</h2>
        <div class="tabla-envuelta mb-3">
            <table class="tabla-lista">
                <thead>
                    <tr><th>Período</th><th class="text-end">Facturas</th><th class="text-end">Subtotal (C$)</th><th class="text-end">IVA (C$)</th><th class="text-end">Total (C$)</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in montos)
                    {
                        <tr>
                            <td class="fw-semibold">@m.Periodo</td>
                            <td class="text-end">@m.Facturas</td>
                            <td class="text-end">@m.Subtotal.ToString("N2")</td>
                            <td class="text-end">@m.IVA.ToString("N2")</td>
                            <td class="text-end fw-semibold">@m.Total.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2 class="h6 fw-bold text-primary"><i class="bi bi-list-check me-1"></i> Detalle de facturas del período</h2>
    @if (facturas.Count == 0)
    {
        <div class="estado-vacio">
            <i class="bi bi-receipt"></i>
            <div class="fw-semibold">No hay facturas en el período seleccionado</div>
            <div style="font-size:.85rem">Ajuste las fechas o emita nuevas facturas.</div>
        </div>
    }
    else
    {
        <div class="tabla-envuelta">
            <table class="tabla-lista">
                <thead>
                    <tr>
                        <th>Número</th><th>Fecha</th><th>Cliente</th>
                        <th class="text-end">Subtotal (C$)</th><th class="text-end">IVA (C$)</th><th class="text-end">Total (C$)</th>
                        <th>Estado</th><th class="acciones"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in facturas.OrderByDescending(f => f.Fecha))
                    {
                        <tr>
                            <td class="fw-semibold">@f.NumeroFactura</td>
                            <td>@f.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>@f.Cliente</td>
                            <td class="text-end">@f.Subtotal.ToString("N2")</td>
                            <td class="text-end">@f.IVA.ToString("N2")</td>
                            <td class="text-end fw-semibold">@f.Total.ToString("N2")</td>
                            <td><span class="estado estado-@f.Estado.ToLowerInvariant()">@f.Estado</span></td>
                            <td class="acciones">
                                <a asp-controller="Facturas" asp-action="Detalles" asp-route-id="@f.IdFactura" class="btn btn-sm btn-outline-primary btn-icono" title="Ver factura">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Totales del período:</th>
                        <th class="text-end">C$ @facturas.Sum(f => f.Subtotal).ToString("N2")</th>
                        <th class="text-end">C$ @facturas.Sum(f => f.IVA).ToString("N2")</th>
                        <th class="text-end">C$ @facturas.Sum(f => f.Total).ToString("N2")</th>
                        <th colspan="2"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="form-text mt-2">
            Los totales incluyen también las facturas anuladas; las tarjetas superiores consideran únicamente las emitidas.
        </div>
    }
</div>
