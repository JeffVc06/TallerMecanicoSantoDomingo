@model TallerMecanicoSantoDomingo.ViewModels.TrabajadorFormViewModel
@{
    ViewData["Title"] = "Editar trabajador";
    var areas = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Areas;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-pencil-square me-2"></i>Editar trabajador</h1>
        <div class="ruta"><a asp-action="Index">Trabajadores</a> / Editar registro</div>
    </div>
</div>

<div class="tarjeta" style="max-width:720px">
    <form asp-action="Editar" method="post" class="formulario">
        <input type="hidden" asp-for="IdTrabajador" />
        <div asp-validation-summary="ModelOnly" class="alerta-error"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Apellido" class="form-label"></label>
                <input asp-for="Apellido" class="form-control" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="IdArea" class="form-label"></label>
                <select asp-for="IdArea" class="form-select" asp-items="areas">
                    <option value="">— Seleccione el área —</option>
                </select>
                <span asp-validation-for="IdArea" class="text-danger"></span>
                <div class="form-text">Regla 5: al cambiar el área, las próximas asignaciones se validarán contra la nueva área.</div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-azul"><i class="bi bi-save me-1"></i> Guardar cambios</button>
            <a asp-action="Detalles" asp-route-id="@Model.IdTrabajador" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidacionScripts" />
}
