{
  "ConnectionStrings": {
    // Cadena de conexión a SQL Server.
    // Conexión local en Windows (usa memoria compartida).
    // SQL Server (usuario/contraseña): Server=localhost;Database=TallerMecanicoSantoDomingo;User Id=sa;Password=SU_CONTRASENA;TrustServerCertificate=True
    // Se puede sobreescribir con la variable de entorno: ConnectionStrings__TallerDB
    "TallerDB": "Server=lpc:localhost;Database=TallerMecanicoSantoDomingo;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "ConfiguracionTaller": {
    // Nombre comercial mostrado en facturas y reportes.
    "NombreTaller": "Taller Mecánico Santo Domingo",
    "DireccionTaller": "Managua, Nicaragua",
    "TelefonoTaller": "0000-0000",
    // Tasa de IVA en porcentaje. El documento original no define la tasa,
    // por lo que se deja configurable. Valor inicial: 15% (Nicaragua).
    "PorcentajeIVA": 15
  },
  // Semilla opcional del primer administrador (recomendado: configurar con
  // "dotnet user-secrets" para no guardar la contraseña en el repositorio).
  // Si no se configura, el sistema ofrece una página de configuración inicial
  // la única vez que no existe ningún usuario.
  "AdministradorInicial": {
    "Email": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
