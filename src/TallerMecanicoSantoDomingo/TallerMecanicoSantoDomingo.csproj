<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TallerMecanicoSantoDomingo</RootNamespace>
    <AssemblyName>TallerMecanicoSantoDomingo</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- El script SQL (fuente única del esquema) queda incrustado en la aplicación
       para permitir la creación automática de la base de datos en el primer arranque. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\database\TallerMecanicoSantoDomingo.sql" LogicalName="EsquemaBD.sql" />
  </ItemGroup>

</Project>
