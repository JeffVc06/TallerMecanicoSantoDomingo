<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TallerMecanicoSantoDomingo</RootNamespace>
    <AssemblyName>TallerMecanicoSantoDomingo</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- F5 ejecuta el DLL con vsdbg; no se necesita apphost.exe y así se evita
         el error de copia cuando Windows mantiene ese ejecutable bloqueado. -->
    <UseAppHost>false</UseAppHost>
    <UserSecretsId>c54087ed-3af0-43af-bd57-cab72737786a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <!-- Anula la versión vulnerable transitiva requerida por Microsoft.Data.SqlClient. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TallerMecanicoSantoDomingo.Tests" />
  </ItemGroup>

  <!-- El script SQL (fuente única del esquema) queda incrustado en la aplicación
       para permitir la creación automática de la base de datos en el primer arranque. -->
  <ItemGroup>
    <EmbeddedResource Include="../database/TallerMecanicoSantoDomingo.sql" LogicalName="EsquemaBD.sql" />
  </ItemGroup>

</Project>
