@model TallerMecanicoSantoDomingo.ViewModels.VehiculoFormViewModel
@{
    ViewData["Title"] = "Editar vehículo";
    var clientes = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Clientes;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-pencil-square me-2"></i>Editar vehículo</h1>
        <div class="ruta"><a asp-action="Index">Vehículos</a> / Editar registro</div>
    </div>
</div>

<div class="tarjeta" style="max-width:720px">
    <form asp-action="Editar" method="post" class="formulario">
        <input type="hidden" asp-for="IdVehiculo" />
        <div asp-validation-summary="ModelOnly" class="alerta-error"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="IdCliente" class="form-label"></label>
                <select asp-for="IdCliente" class="form-select" asp-items="clientes">
                    <option value="">— Seleccione el cliente propietario —</option>
                </select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Placa" class="form-label"></label>
                <input asp-for="Placa" class="form-control" style="text-transform:uppercase" />
                <span asp-validation-for="Placa" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Marca" class="form-label"></label>
                <input asp-for="Marca" class="form-control" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Modelo" class="form-label"></label>
                <input asp-for="Modelo" class="form-control" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Anio" class="form-label"></label>
                <input asp-for="Anio" class="form-control" type="number" min="1950" max="2100" />
                <span asp-validation-for="Anio" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-azul"><i class="bi bi-save me-1"></i> Guardar cambios</button>
            <a asp-action="Detalles" asp-route-id="@Model.IdVehiculo" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
