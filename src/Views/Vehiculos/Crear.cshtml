@model TallerMecanicoSantoDomingo.ViewModels.VehiculoFormViewModel
@{
    ViewData["Title"] = "Registrar vehículo";
    var clientes = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Clientes;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-car-front me-2" aria-hidden="true"></i>Registrar vehículo</h1>
        <div class="ruta"><a asp-action="Index">Vehículos</a> / Nuevo registro</div>
    </div>
</div>

<div class="tarjeta formulario-tarjeta">
    <form asp-action="Crear" method="post" class="formulario">
        <div asp-validation-summary="ModelOnly" class="alerta-error" role="alert"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="IdCliente" class="form-label"></label>
                <select asp-for="IdCliente" class="form-select" asp-items="clientes">
                    <option value="">— Seleccione el cliente propietario —</option>
                </select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
                <div class="form-text">Seleccione el propietario del vehículo.</div>
            </div>
            <div class="col-12"><h2 class="formulario-seccion">Datos del vehículo</h2></div>
            <div class="col-md-4">
                <label asp-for="Placa" class="form-label"></label>
                <input asp-for="Placa" class="form-control text-uppercase" placeholder="MGA-1234" maxlength="20" style="text-transform:uppercase" aria-describedby="ayuda-placa" />
                <div id="ayuda-placa" class="form-text">Letras y números; admite espacios o guiones. Cambiar los separadores no permite repetir una placa.</div>
                <span asp-validation-for="Placa" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Marca" class="form-label"></label>
                <input asp-for="Marca" class="form-control" placeholder="Toyota" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Modelo" class="form-label"></label>
                <input asp-for="Modelo" class="form-control" placeholder="Corolla" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Anio" class="form-label"></label>
                <input asp-for="Anio" class="form-control" type="number" min="1950" max="@(DateTime.Now.Year + 1)" required />
                <span asp-validation-for="Anio" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Kilometraje" class="form-label"></label>
                <input asp-for="Kilometraje" class="form-control" type="number" min="0" />
                <span asp-validation-for="Kilometraje" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Color" class="form-label"></label>
                <input asp-for="Color" class="form-control" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="NumChasis" class="form-label"></label>
                <input asp-for="NumChasis" class="form-control text-uppercase" maxlength="50" aria-describedby="ayuda-chasis" />
                <div id="ayuda-chasis" class="form-text">Opcional. Letras y números; admite espacios o guiones y no puede pertenecer a otro vehículo.</div>
                <span asp-validation-for="NumChasis" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Tipo" class="form-label"></label>
                <input asp-for="Tipo" class="form-control" />
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
        </div>

        <div class="acciones-formulario">
            <button type="submit" class="btn btn-naranja"><i class="bi bi-save me-1" aria-hidden="true"></i> Guardar vehículo</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
