@model TallerMecanicoSantoDomingo.Services.ResultadoPaginado<TallerMecanicoSantoDomingo.Models.Vehiculo>
@{
    ViewData["Title"] = "Vehículos";
    var clientes = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Clientes;
    var clientesSeleccion = new SelectList(clientes, "Value", "Text", ViewBag.IdCliente);
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-car-front me-2" aria-hidden="true"></i>Vehículos</h1>
        <div class="ruta">Vehículos registrados y sus propietarios</div>
    </div>
    <a asp-action="Crear" class="btn btn-naranja"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Registrar vehículo</a>
</div>

<div class="tarjeta">
    <form asp-action="Index" method="get" data-busqueda class="filtros row g-2 align-items-end mb-3">
        <input type="hidden" name="pagina" value="1" />
        <div class="col-sm-5 col-md-5">
            <label for="filtro-buscar" class="form-label fw-semibold text-primary">Buscar por placa, marca, modelo o cliente</label>
            <input id="filtro-buscar" type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Escriba para buscar..." />
        </div>
        <div class="col-sm-4 col-md-4">
            <label for="filtro-idcliente" class="form-label fw-semibold text-primary">Cliente</label>
            <select id="filtro-idcliente" name="idCliente" class="form-select" asp-items="clientesSeleccion">
                <option value="">Todos los clientes</option>
            </select>
        </div>
        <div class="col-sm-3 col-md-3">
            <button type="submit" class="btn btn-azul w-100"><i class="bi bi-search me-1" aria-hidden="true"></i> Buscar</button>
        </div>
    </form>

    @if (Model.Elementos.Count == 0)
    {
        <div class="estado-vacio">
            <i class="bi bi-car-front" aria-hidden="true"></i>
            <div class="fw-semibold">No se encontraron vehículos</div>
            <div style="font-size:.85rem">Registre el primer vehículo vinculado a un cliente existente.</div>
        </div>
    }
    else
    {
        <div class="tabla-envuelta tabla-acciones-fijas" role="region" aria-label="Listado de vehículos" tabindex="0">
            <table class="tabla-lista tabla-adaptable" role="table">
                <thead role="rowgroup">
                    <tr role="row">
                        <th scope="col">Placa</th>
                        <th scope="col">Marca y modelo</th>
                        <th scope="col">Año</th>
                        <th scope="col">Propietario</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody role="rowgroup">
                    @foreach (var v in Model.Elementos)
                    {
                        <tr role="row">
                            <td role="cell" data-etiqueta="Placa" class="fw-semibold">@v.Placa</td>
                            <td role="cell" data-etiqueta="Marca y modelo">@v.Marca @v.Modelo</td>
                            <td role="cell" data-etiqueta="Año">@v.Anio</td>
                            <td role="cell" data-etiqueta="Propietario">@v.Cliente?.NombreCompleto</td>
                            <td role="cell" data-etiqueta="Estado"><span class="estado @(v.Activo ? "estado-activo" : "estado-inactivo")">@(v.Activo ? "Activo" : "Desactivado")</span></td>
                            <td role="cell" data-etiqueta="Acciones" class="acciones">
                                <a asp-action="Detalles" asp-route-id="@v.IdVehiculo" class="btn btn-sm btn-outline-primary btn-icono" title="Ver ficha e historial" aria-label="Ver ficha e historial">
                                    <i class="bi bi-eye" aria-hidden="true"></i><span class="etiqueta-accion">Ver ficha</span>
                                </a>
                                <a asp-action="Editar" asp-route-id="@v.IdVehiculo" class="btn btn-sm btn-outline-secondary btn-icono" title="Editar" aria-label="Editar">
                                    <i class="bi bi-pencil" aria-hidden="true"></i><span class="etiqueta-accion">Editar</span>
                                </a>
                                <a asp-controller="Servicios" asp-action="Crear" asp-route-idVehiculo="@v.IdVehiculo" class="btn btn-sm btn-outline-warning btn-icono" title="Nuevo servicio para este vehículo" aria-label="Nuevo servicio para este vehículo">
                                    <i class="bi bi-gear" aria-hidden="true"></i><span class="etiqueta-accion">Nuevo servicio</span>
                                </a>
                                <form asp-action="CambiarEstado" asp-route-id="@v.IdVehiculo" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="activo" value="@(!v.Activo)" />
                                    <button type="submit" class="btn btn-sm @(v.Activo ? "btn-outline-danger" : "btn-outline-success") btn-icono"
                                            title="@(v.Activo ? "Desactivar" : "Reactivar")"
                                            data-confirmar="¿Desea @(v.Activo ? "desactivar" : "reactivar") el vehículo @(v.Placa)?" aria-label="@(v.Activo ? "Desactivar" : "Reactivar")">
                                        <i class="bi @(v.Activo ? "bi-slash-circle" : "bi-arrow-counterclockwise")" aria-hidden="true"></i><span class="etiqueta-accion">@(v.Activo ? "Desactivar" : "Reactivar")</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="pie-listado" aria-label="Paginación">
                <span class="texto-secundario" style="font-size:.83rem">
                    Página @Model.Pagina de @Model.TotalPaginas — @Model.TotalElementos registro(s)
                </span>
                <div class="paginacion">
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <a class="btn btn-sm @(p == Model.Pagina ? "actual" : "btn-outline-secondary")"
                           aria-current="@(p == Model.Pagina ? "page" : null)" asp-action="Index" asp-route-pagina="@p" asp-route-buscar="@ViewBag.Buscar" asp-route-idCliente="@ViewBag.IdCliente">@p</a>
                    }
                </div>
            </nav>
        }
    }
</div>
