@model TallerMecanicoSantoDomingo.Services.DatosDashboard
@{
    ViewData["Title"] = "Resumen del taller";
    bool vacio = Model.TotalClientes == 0 && Model.TotalVehiculos == 0 && Model.ServiciosActivos == 0 &&
                 Model.TotalTrabajadores == 0 && Model.TotalProductos == 0 && Model.FacturasEmitidas == 0;
}

<section class="dashboard-portada">
    <div class="dashboard-portada__contenido">
        <div class="dashboard-portada__eyebrow"><span></span> CONTROL OPERATIVO</div>
        <h1>El taller,<br /><em>en marcha.</em></h1>
        <p>Una vista clara de los trabajos, el equipo y la actividad reciente de Santo Domingo.</p>
        <div class="dashboard-portada__acciones">
            <a asp-controller="Servicios" asp-action="Crear" class="btn btn-portada">
                <i class="bi bi-plus-lg me-2"></i>Registrar servicio
            </a>
            <a asp-controller="Servicios" asp-action="Index" class="dashboard-portada__enlace">
                Ver servicios <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>
    </div>
    <div class="dashboard-portada__resumen" aria-label="Servicios actualmente abiertos">
        <div class="dashboard-portada__icono"><i class="bi bi-tools"></i></div>
        <div class="dashboard-portada__dato">@Model.ServiciosActivos</div>
        <div class="dashboard-portada__rotulo">SERVICIOS EN CURSO</div>
        <div class="dashboard-portada__pie"><span class="punto-en-vivo"></span> Seguimiento activo</div>
    </div>
    <div class="dashboard-portada__marca" aria-hidden="true"><i class="bi bi-gear-wide-connected"></i></div>
</section>

@if (vacio)
{
    <div class="alerta-info">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Aún no hay actividad.</strong> Registra el primer cliente para comenzar.
        <a asp-controller="Clientes" asp-action="Crear" class="fw-semibold">Agregar cliente</a>.
    </div>
}

<div class="dashboard-indicadores">
    <div class="col-6 col-lg-3">
        <a asp-controller="Clientes" asp-action="Index" class="indicador-moderno indicador-moderno--azul">
            <div class="indicador-moderno__cabecera"><span>CLIENTES</span><i class="bi bi-people"></i></div>
            <strong>@Model.TotalClientes</strong><div class="indicador-moderno__pie">Directorio <i class="bi bi-arrow-up-right"></i></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Vehiculos" asp-action="Index" class="indicador-moderno indicador-moderno--gris">
            <div class="indicador-moderno__cabecera"><span>VEHÍCULOS</span><i class="bi bi-car-front"></i></div>
            <strong>@Model.TotalVehiculos</strong><div class="indicador-moderno__pie">Parque vehicular <i class="bi bi-arrow-up-right"></i></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Servicios" asp-action="Index" class="indicador-moderno indicador-moderno--naranja">
            <div class="indicador-moderno__cabecera"><span>EN CURSO</span><i class="bi bi-wrench-adjustable"></i></div>
            <strong>@Model.ServiciosActivos</strong><div class="indicador-moderno__pie">Servicios abiertos <i class="bi bi-arrow-up-right"></i></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Servicios" asp-action="Index" class="indicador-moderno indicador-moderno--verde">
            <div class="indicador-moderno__cabecera"><span>FINALIZADOS</span><i class="bi bi-check2-circle"></i></div>
            <strong>@Model.ServiciosFinalizados</strong><div class="indicador-moderno__pie">Trabajo entregado <i class="bi bi-arrow-up-right"></i></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Trabajadores" asp-action="Index" class="indicador-moderno indicador-moderno--azul">
            <div class="indicador-moderno__cabecera"><span>EQUIPO</span><i class="bi bi-person-badge"></i></div>
            <strong>@Model.TotalTrabajadores</strong><div class="indicador-moderno__pie">Personal registrado <i class="bi bi-arrow-up-right"></i></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Productos" asp-action="Index" class="indicador-moderno indicador-moderno--gris">
            <div class="indicador-moderno__cabecera"><span>PRODUCTOS</span><i class="bi bi-box-seam"></i></div>
            <strong>@Model.TotalProductos</strong><div class="indicador-moderno__pie">Catálogo del taller <i class="bi bi-arrow-up-right"></i></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Facturas" asp-action="Index" class="indicador-moderno indicador-moderno--verde">
            <div class="indicador-moderno__cabecera"><span>FACTURAS</span><i class="bi bi-receipt"></i></div>
            <strong>@Model.FacturasEmitidas</strong><div class="indicador-moderno__pie">Emitidas <i class="bi bi-arrow-up-right"></i></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Facturas" asp-action="Index" class="indicador-moderno indicador-moderno--naranja indicador-moderno--importe">
            <div class="indicador-moderno__cabecera"><span>FACTURACIÓN</span><i class="bi bi-cash-stack"></i></div>
            <strong>C$ @Model.ImporteFacturado.ToString("N2")</strong><div class="indicador-moderno__pie">Total emitido <i class="bi bi-arrow-up-right"></i></div>
        </a>
    </div>
</div>

@if (Model.TrabajadoresAlLimite.Count > 0)
{
    <div class="alerta-error d-flex align-items-center gap-2 mt-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>
            <strong>Trabajadores al límite de capacidad (2 de 2 servicios activos):</strong>
            @string.Join(", ", Model.TrabajadoresAlLimite). Se les rechazarán nuevas asignaciones hasta finalizar o cancelar un servicio.
        </span>
    </div>
}

<div class="dashboard-seccion-cabecera">
    <div><span class="dashboard-seccion-cabecera__kicker">LECTURA RÁPIDA</span><h2>Actividad del taller</h2></div>
    <span class="dashboard-seccion-cabecera__nota">Distribución y facturación</span>
</div>
<div class="row g-3 dashboard-graficos">
    <div class="col-lg-4">
        <div class="tarjeta h-100">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-pie-chart me-1"></i> Servicios por tipo</h2>
            <canvas id="graficoTipo" height="220"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="tarjeta h-100">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-diagram-3 me-1"></i> Servicios por estado</h2>
            <canvas id="graficoEstado" height="220"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="tarjeta h-100">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-graph-up me-1"></i> Facturación (12 meses)</h2>
            <canvas id="graficoFacturacion" height="220"></canvas>
        </div>
    </div>
</div>

<div class="tarjeta dashboard-recientes mt-3">
    <div class="dashboard-recientes__cabecera">
        <div><span class="dashboard-seccion-cabecera__kicker">BITÁCORA</span><h2>Servicios recientes</h2></div>
        <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-primary">Ver todos <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    @if (Model.UltimosServicios.Count == 0)
    {
        <div class="estado-vacio">
            <i class="bi bi-inbox"></i>
            <div>Aún no se han registrado servicios.</div>
        </div>
    }
    else
    {
        <div class="tabla-envuelta">
            <table class="tabla-lista">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Fecha inicio</th>
                        <th>Placa</th>
                        <th>Cliente</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th class="text-end">Monto</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.UltimosServicios)
                    {
                        <tr>
                            <td class="fw-semibold">@s.IdServicio</td>
                            <td>@s.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@s.Placa</td>
                            <td>@s.Cliente</td>
                            <td><span class="estado tipo-@s.TipoServicio.ToLowerInvariant()">@s.TipoServicio</span></td>
                            <td><span class="estado estado-@s.Estado.ToLowerInvariant()">@s.Estado</span></td>
                            <td class="text-end">@s.Total.ToString("N2")</td>
                            <td class="acciones">
                                <a asp-controller="Servicios" asp-action="Detalles" asp-route-id="@s.IdServicio"
                                   class="btn btn-sm btn-outline-primary btn-icono" title="Ver detalle">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        const colores = ['#426875', '#b96320', '#65816e', '#ad5c50', '#8c9692'];

        new Chart(document.getElementById('graficoTipo'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EtiquetasServiciosPorTipo.Count > 0 ? Model.EtiquetasServiciosPorTipo : new List<string> { "Sin datos" })),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValoresServiciosPorTipo.Count > 0 ? Model.ValoresServiciosPorTipo : new List<int> { 0 })),
                    backgroundColor: colores,
                    borderWidth: 3,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                animation: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? false : { duration: 550 },
                plugins: { legend: { position: 'bottom' } }
            }
        });

        new Chart(document.getElementById('graficoEstado'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EtiquetasServiciosPorEstado.Count > 0 ? Model.EtiquetasServiciosPorEstado : new List<string> { "Sin datos" })),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValoresServiciosPorEstado.Count > 0 ? Model.ValoresServiciosPorEstado : new List<int> { 0 })),
                    backgroundColor: ['#b96320', '#65816e', '#ad5c50', '#426875', '#8c9692'],
                    borderWidth: 3,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                animation: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? false : { duration: 550 },
                plugins: { legend: { position: 'bottom' } }
            }
        });

        new Chart(document.getElementById('graficoFacturacion'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EtiquetasFacturacionMensual)),
                datasets: [{
                    label: 'Facturado (C$)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValoresFacturacionMensual)),
                    backgroundColor: '#426875',
                    borderRadius: 4
                }]
            },
            options: {
                animation: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? false : { duration: 650 },
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}
