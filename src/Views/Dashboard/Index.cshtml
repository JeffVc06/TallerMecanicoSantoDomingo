@model TallerMecanicoSantoDomingo.Services.DatosDashboard
@{
    ViewData["Title"] = "Resumen del taller";
    bool vacio = Model.TotalClientes == 0 && Model.TotalVehiculos == 0 && Model.ServiciosActivos == 0 &&
                 Model.TotalTrabajadores == 0 && Model.TotalProductos == 0 && Model.FacturasEmitidas == 0;
    string ResumenGrafico(List<string> etiquetas, List<int> valores) => etiquetas.Count == 0
        ? "Sin datos"
        : string.Join(", ", etiquetas.Zip(valores, (etiqueta, valor) => $"{etiqueta}: {valor}"));
    var resumenFacturacion = string.Join(", ", Model.EtiquetasFacturacionMensual.Zip(Model.ValoresFacturacionMensual,
        (mes, monto) => $"{mes}: C$ {monto:N2}"));
}

<section class="dashboard-portada" aria-labelledby="titulo-resumen">
    <div>
        <h1 id="titulo-resumen">Resumen del taller</h1>
        <p>Consulta los trabajos recientes, la carga del equipo y la facturación.</p>
    </div>
    <div class="dashboard-portada__acciones">
        <a asp-controller="Servicios" asp-action="Crear" class="btn btn-naranja">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Registrar servicio
        </a>
        <a asp-controller="Servicios" asp-action="Index" class="btn btn-portada-secundario">
            Ver servicios <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
        </a>
    </div>
</section>

@if (vacio)
{
    <div class="alerta-info" role="status">
        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
        <strong>Aún no hay actividad.</strong> Registra el primer cliente para comenzar.
        <a asp-controller="Clientes" asp-action="Crear" class="fw-semibold">Agregar cliente</a>.
    </div>
}

<section class="dashboard-indicadores" aria-label="Indicadores principales">
    <a asp-controller="Servicios" asp-action="Index" class="indicador-moderno indicador-moderno--prioritario">
        <span class="indicador-moderno__etiqueta">Servicios en curso</span>
        <span class="icono-indicador fondo-naranja" aria-hidden="true"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i></span>
        <strong>@Model.ServiciosActivos</strong>
    </a>
    <a asp-controller="Servicios" asp-action="Index" class="indicador-moderno">
        <span class="indicador-moderno__etiqueta">Servicios finalizados</span>
        <span class="icono-indicador fondo-verde" aria-hidden="true"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
        <strong>@Model.ServiciosFinalizados</strong>
    </a>
    <a asp-controller="Facturas" asp-action="Index" class="indicador-moderno">
        <span class="indicador-moderno__etiqueta">Facturas emitidas</span>
        <span class="icono-indicador fondo-azul" aria-hidden="true"><i class="bi bi-receipt" aria-hidden="true"></i></span>
        <strong>@Model.FacturasEmitidas</strong>
    </a>
    <a asp-controller="Facturas" asp-action="Index" class="indicador-moderno indicador-moderno--importe">
        <span class="indicador-moderno__etiqueta">Total facturado</span>
        <span class="icono-indicador fondo-azul" aria-hidden="true"><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
        <strong>C$ @Model.ImporteFacturado.ToString("N2")</strong>
    </a>
</section>

<div class="dashboard-contenido">
    @if (Model.TrabajadoresAlLimite.Count > 0)
    {
        <section class="dashboard-alerta" aria-labelledby="titulo-capacidad">
            <h2 id="titulo-capacidad"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Límite de asignaciones</h2>
            <p>Estos trabajadores tienen 2 de 2 servicios activos.</p>
            <ul>
                @foreach (var trabajador in Model.TrabajadoresAlLimite)
                {
                    <li>@trabajador</li>
                }
            </ul>
            <p>Podrán recibir otra asignación cuando se finalice o cancele uno de sus servicios.</p>
        </section>
    }

    <section class="tarjeta dashboard-recientes" aria-labelledby="titulo-recientes">
        <div class="cabecera-panel">
            <h2 id="titulo-recientes">Servicios recientes</h2>
            <a asp-controller="Servicios" asp-action="Index" class="btn btn-sm btn-outline-primary">
                Ver todos <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
            </a>
        </div>

        @if (Model.UltimosServicios.Count == 0)
        {
            <div class="estado-vacio">
                <i class="bi bi-inbox" aria-hidden="true"></i>
                <div>Aún no se han registrado servicios.</div>
            </div>
        }
        else
        {
            <div class="tabla-envuelta tabla-acciones-fijas" role="region" aria-labelledby="titulo-recientes" tabindex="0">
                <table class="tabla-lista tabla-adaptable" role="table">
                    <thead role="rowgroup">
                        <tr role="row">
                            <th scope="col">Vehículo</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Servicio</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end">Monto (C$)</th>
                            <th scope="col" class="acciones"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody role="rowgroup">
                        @foreach (var s in Model.UltimosServicios)
                        {
                            <tr role="row">
                                <td role="cell" data-etiqueta="Vehículo">
                                    <span class="orden-placa">@s.Placa</span>
                                    <span class="orden-fecha"><span class="visually-hidden">Fecha de inicio </span>@s.FechaInicio.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td role="cell" data-etiqueta="Cliente">@s.Cliente</td>
                                <td role="cell" data-etiqueta="Servicio">
                                    <span class="orden-fecha">#@s.IdServicio</span>
                                    <span class="estado tipo-@s.TipoServicio.ToLowerInvariant()">@s.TipoServicio</span>
                                </td>
                                <td role="cell" data-etiqueta="Estado"><span class="estado estado-@s.Estado.ToLowerInvariant()">@s.Estado</span></td>
                                <td role="cell" data-etiqueta="Monto (C$)" class="text-end">@s.Total.ToString("N2")</td>
                                <td role="cell" data-etiqueta="Acciones" class="acciones">
                                    <a asp-controller="Servicios" asp-action="Detalles" asp-route-id="@s.IdServicio"
                                       class="btn btn-sm btn-outline-primary btn-icono" title="Ver detalle" aria-label="Ver detalle del servicio @s.IdServicio">
                                        <i class="bi bi-eye" aria-hidden="true"></i><span class="etiqueta-accion">Ver</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="dashboard-resumen">
        <section class="tarjeta dashboard-directorio" aria-labelledby="titulo-directorio">
            <div class="cabecera-panel"><h2 id="titulo-directorio">Registros del taller</h2></div>
            <ul>
                <li>
                    <a asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-people" aria-hidden="true"></i><span>Clientes</span><strong>@Model.TotalClientes</strong><i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </li>
                <li>
                    <a asp-controller="Vehiculos" asp-action="Index">
                        <i class="bi bi-car-front" aria-hidden="true"></i><span>Vehículos</span><strong>@Model.TotalVehiculos</strong><i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </li>
                <li>
                    <a asp-controller="Trabajadores" asp-action="Index">
                        <i class="bi bi-person-badge" aria-hidden="true"></i><span>Trabajadores</span><strong>@Model.TotalTrabajadores</strong><i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </li>
                <li>
                    <a asp-controller="Productos" asp-action="Index">
                        <i class="bi bi-box-seam" aria-hidden="true"></i><span>Productos</span><strong>@Model.TotalProductos</strong><i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </li>
            </ul>
        </section>

        <section class="tarjeta dashboard-grafico-estado" aria-labelledby="titulo-grafico-estado">
            <div class="cabecera-panel"><h2 id="titulo-grafico-estado">Servicios por estado</h2></div>
            <div class="grafico-lienzo grafico-lienzo--compacto">
                <canvas id="graficoEstado" role="img" aria-label="Servicios por estado. @ResumenGrafico(Model.EtiquetasServiciosPorEstado, Model.ValoresServiciosPorEstado)"></canvas>
            </div>
        </section>
    </div>
</div>

<section class="dashboard-graficos" aria-labelledby="titulo-actividad">
    <div class="cabecera-panel"><h2 id="titulo-actividad">Actividad del taller</h2></div>
    <div class="dashboard-graficos__rejilla">
        <section class="tarjeta grafico-facturacion" aria-labelledby="titulo-grafico-facturacion">
            <h3 id="titulo-grafico-facturacion">Facturación emitida · 12 meses</h3>
            <div class="grafico-lienzo">
                <canvas id="graficoFacturacion" role="img" aria-label="Facturación mensual en córdobas. @resumenFacturacion"></canvas>
            </div>
        </section>
        <section class="tarjeta" aria-labelledby="titulo-grafico-tipo">
            <h3 id="titulo-grafico-tipo">Servicios por tipo</h3>
            <div class="grafico-lienzo">
                <canvas id="graficoTipo" role="img" aria-label="Servicios por tipo. @ResumenGrafico(Model.EtiquetasServiciosPorTipo, Model.ValoresServiciosPorTipo)"></canvas>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        (() => {
            const tema = getComputedStyle(document.documentElement);
            const color = nombre => tema.getPropertyValue('--' + nombre).trim();
            const fuente = color('fuente-interfaz');
            const reducirMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const leyenda = {
                position: 'bottom',
                labels: { color: color('color-texto'), font: { family: fuente, size: 11 }, usePointStyle: true, boxWidth: 8, padding: 12 }
            };

            function crearAnillo(id, labels, valores, colores) {
                new Chart(document.getElementById(id), {
                    type: 'doughnut',
                    data: {
                        labels,
                        datasets: [{
                            data: valores,
                            backgroundColor: labels.map(etiqueta => colores[etiqueta] ?? color('color-gris-claro')),
                            borderWidth: 2,
                            borderColor: color('color-blanco')
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        cutout: '67%',
                        animation: reducirMovimiento ? false : { duration: 360 },
                        plugins: { legend: leyenda }
                    }
                });
            }

            crearAnillo('graficoTipo',
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EtiquetasServiciosPorTipo.Count > 0 ? Model.EtiquetasServiciosPorTipo : new List<string> { "Sin datos" })),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValoresServiciosPorTipo.Count > 0 ? Model.ValoresServiciosPorTipo : new List<int> { 0 })),
                { Mantenimiento: color('color-azul-claro'), Pintura: color('color-naranja') });

            crearAnillo('graficoEstado',
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EtiquetasServiciosPorEstado.Count > 0 ? Model.EtiquetasServiciosPorEstado : new List<string> { "Sin datos" })),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValoresServiciosPorEstado.Count > 0 ? Model.ValoresServiciosPorEstado : new List<int> { 0 })),
                { Abierto: color('color-naranja'), Finalizado: color('color-verde'), Cancelado: color('color-rojo') });

            const meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
            const importe = new Intl.NumberFormat('es-NI', { notation: 'compact', maximumFractionDigits: 1 });
            const estiloEje = { color: color('color-gris'), font: { family: fuente, size: 10 } };

            new Chart(document.getElementById('graficoFacturacion'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EtiquetasFacturacionMensual)),
                    datasets: [{
                        label: 'Facturado',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValoresFacturacionMensual)),
                        backgroundColor: color('color-azul-claro'),
                        borderRadius: 4,
                        maxBarThickness: 28
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    animation: reducirMovimiento ? false : { duration: 400 },
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: contexto => formatearMoneda(contexto.parsed.y) } }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                ...estiloEje,
                                maxRotation: 0,
                                callback(valor) {
                                    const etiqueta = this.getLabelForValue(valor);
                                    return meses[Number(etiqueta.slice(0, 2)) - 1] ?? etiqueta;
                                }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: color('color-borde') },
                            ticks: { ...estiloEje, maxTicksLimit: 5, callback: valor => 'C$ ' + importe.format(valor) }
                        }
                    }
                }
            });
        })();
    </script>
}
