@model TallerMecanicoSantoDomingo.Models.Trabajador
@{
    ViewData["Title"] = "Ficha del trabajador";
    var asignaciones = (List<TallerMecanicoSantoDomingo.Services.ItemAsignacion>)ViewBag.Asignaciones;
    var carga = ViewBag.Carga as TallerMecanicoSantoDomingo.Services.TrabajadorCarga;
    int activos = carga?.ServiciosActivos ?? 0;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-person-vcard me-2" aria-hidden="true"></i>@Model.NombreCompleto</h1>
        <div class="ruta"><a asp-action="Index">Trabajadores</a> / Ficha del trabajador</div>
    </div>
    <a asp-action="Editar" asp-route-id="@Model.IdTrabajador" class="btn btn-azul"><i class="bi bi-pencil me-1" aria-hidden="true"></i> Editar</a>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-card-text me-1" aria-hidden="true"></i> Datos</h2>
            <dl class="row mb-0" style="font-size:.9rem">
                <dt class="col-5 texto-secundario">Área</dt>
                <dd class="col-7 fw-semibold">@Model.Area</dd>
                <dt class="col-5 texto-secundario">Teléfono</dt>
                <dd class="col-7">@Model.Telefono</dd>
                <dt class="col-5 texto-secundario">Correo</dt>
                <dd class="col-7">@(Model.Correo ?? "—")</dd>
                <dt class="col-5 texto-secundario">Estado</dt>
                <dd class="col-7"><span class="estado @(Model.Activo ? "estado-activo" : "estado-inactivo")">@(Model.Activo ? "Activo" : "Desactivado")</span></dd>
                <dt class="col-5 texto-secundario">Ingreso</dt>
                <dd class="col-7">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
                <dt class="col-5 texto-secundario">Salida</dt>
                <dd class="col-7">@(Model.FechaSalida?.ToString("dd/MM/yyyy") ?? "—")</dd>
            </dl>
        </div>
        <div class="tarjeta tarjeta-indicador">
            <div class="icono @(activos == 0 ? "fondo-verde" : activos == 1 ? "fondo-naranja" : "fondo-rojo")">
                <i class="bi bi-lightning-charge" aria-hidden="true"></i>
            </div>
            <div>
                <div class="dato">@activos de 2</div>
                <div class="etiqueta">
                    @(activos == 0 ? "Disponible para nuevos trabajos" : activos == 1 ? "Capacidad parcial" : "Límite de servicios activos alcanzado")
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-list-check me-1" aria-hidden="true"></i> Historial de asignaciones (@asignaciones.Count)</h2>

            @if (asignaciones.Count == 0)
            {
                <div class="estado-vacio">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                    <div>Este trabajador aún no ha sido asignado a ningún servicio.</div>
                </div>
            }
            else
            {
                <div class="tabla-envuelta" role="region" aria-label="Historial de asignaciones" tabindex="0">
                    <table class="tabla-lista">
                        <thead>
                            <tr>
                                <th scope="col">Servicio</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Asignado el</th>
                                <th scope="col">Estado asignación</th>
                                <th scope="col">Estado servicio</th>
                                <th scope="col" class="acciones"><span class="visually-hidden">Acciones</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in asignaciones)
                            {
                                <tr>
                                    <td class="fw-semibold">#@a.IdServicio</td>
                                    <td><span class="estado tipo-@a.TipoServicio.ToLowerInvariant()">@a.TipoServicio</span></td>
                                    <td style="max-width:220px">@a.DescripcionServicio</td>
                                    <td>@a.FechaAsignacion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td><span class="estado estado-@a.EstadoAsignacion.ToLowerInvariant()">@a.EstadoAsignacion</span></td>
                                    <td><span class="estado estado-@a.EstadoServicio.ToLowerInvariant()">@a.EstadoServicio</span></td>
                                    <td class="acciones">
                                        <a asp-controller="Servicios" asp-action="Detalles" asp-route-id="@a.IdServicio" class="btn btn-sm btn-outline-primary btn-icono" title="Ver servicio" aria-label="Ver servicio">
                                            <i class="bi bi-eye" aria-hidden="true"></i><span class="etiqueta-accion">Ver servicio</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
