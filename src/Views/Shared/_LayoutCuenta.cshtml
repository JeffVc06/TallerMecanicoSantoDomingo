@using Microsoft.Extensions.Options
@using TallerMecanicoSantoDomingo.Services
@inject IOptions<ConfiguracionTaller> ConfigTaller
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @ConfigTaller.Value.NombreTaller</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="pagina-cuenta">
        <div class="cuenta-marco">
            <div class="cuenta-identidad">
                <div class="escudo" aria-hidden="true"><i class="bi bi-tools" aria-hidden="true"></i></div>
                <strong>@ConfigTaller.Value.NombreTaller</strong>
            </div>
            <div class="cuenta-contenido">
                @RenderBody()
            </div>
        </div>
    </main>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
