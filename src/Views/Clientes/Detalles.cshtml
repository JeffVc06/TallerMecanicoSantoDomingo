@model TallerMecanicoSantoDomingo.Models.Cliente
@{
    ViewData["Title"] = "Ficha del cliente";
    var vehiculos = (List<TallerMecanicoSantoDomingo.Models.Vehiculo>)ViewBag.Vehiculos;
    var totalFacturado = (decimal)ViewBag.TotalFacturado;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-person-vcard me-2" aria-hidden="true"></i>@Model.NombreCompleto</h1>
        <div class="ruta"><a asp-action="Index">Clientes</a> / Ficha del cliente</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Editar" asp-route-id="@Model.IdCliente" class="btn btn-azul"><i class="bi bi-pencil me-1" aria-hidden="true"></i> Editar</a>
        <a asp-controller="Vehiculos" asp-action="Crear" asp-route-idCliente="@Model.IdCliente" class="btn btn-naranja">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Agregar vehículo
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-card-text me-1" aria-hidden="true"></i> Datos del cliente</h2>
            <dl class="row mb-0" style="font-size:.9rem">
                <dt class="col-5 texto-secundario">Cédula</dt>
                <dd class="col-7">@(Model.Cedula ?? "—")</dd>
                <dt class="col-5 texto-secundario">RUC de empresa</dt>
                <dd class="col-7 fw-semibold">@(Model.RFC ?? "—")</dd>
                <dt class="col-5 texto-secundario">Teléfono</dt>
                <dd class="col-7">@Model.Telefono</dd>
                <dt class="col-5 texto-secundario">Dirección</dt>
                <dd class="col-7">@Model.Direccion</dd>
                <dt class="col-5 texto-secundario">Estado</dt>
                <dd class="col-7">
                    <span class="estado @(Model.Activo ? "estado-activo" : "estado-inactivo")">
                        @(Model.Activo ? "Activo" : "Desactivado")
                    </span>
                </dd>
                <dt class="col-5 texto-secundario">Registro</dt>
                <dd class="col-7">@Model.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>
        </div>
        <div class="tarjeta tarjeta-indicador">
            <div class="icono fondo-naranja"><i class="bi bi-cash-stack" aria-hidden="true"></i></div>
            <div>
                <div class="dato" style="font-size:1.25rem">C$ @totalFacturado.ToString("N2")</div>
                <div class="etiqueta">Total facturado (facturas emitidas)</div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-car-front me-1" aria-hidden="true"></i> Vehículos del cliente (@vehiculos.Count)</h2>
            @if (vehiculos.Count == 0)
            {
                <div class="estado-vacio">
                    <i class="bi bi-car-front" aria-hidden="true"></i>
                    <div>Este cliente aún no tiene vehículos registrados.</div>
                </div>
            }
            else
            {
                <div class="tabla-envuelta" role="region" aria-label="Vehículos del cliente" tabindex="0">
                    <table class="tabla-lista">
                        <thead>
                            <tr><th scope="col">Placa</th><th scope="col">Marca</th><th scope="col">Modelo</th><th scope="col">Año</th><th scope="col">Estado</th><th scope="col" class="acciones"><span class="visually-hidden">Acciones</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var v in vehiculos)
                            {
                                <tr>
                                    <td class="fw-semibold">@v.Placa</td>
                                    <td>@v.Marca</td>
                                    <td>@v.Modelo</td>
                                    <td>@v.Anio</td>
                                    <td><span class="estado @(v.Activo ? "estado-activo" : "estado-inactivo")">@(v.Activo ? "Activo" : "Desactivado")</span></td>
                                    <td class="acciones">
                                        <a asp-controller="Historial" asp-action="Index" asp-route-idVehiculo="@v.IdVehiculo" class="btn btn-sm btn-outline-primary btn-icono" title="Ver historial" aria-label="Ver historial">
                                            <i class="bi bi-clock-history" aria-hidden="true"></i><span class="etiqueta-accion">Ver historial</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-receipt me-1" aria-hidden="true"></i> Facturas del cliente</h2>
            @{
                var facturas = Model.Facturas?.OrderByDescending(f => f.FechaFactura).ToList()
                               ?? new List<TallerMecanicoSantoDomingo.Models.Factura>();
            }
            @if (facturas.Count == 0)
            {
                <div class="estado-vacio">
                    <i class="bi bi-receipt" aria-hidden="true"></i>
                    <div>Este cliente aún no tiene facturas emitidas.</div>
                </div>
            }
            else
            {
                <div class="tabla-envuelta" role="region" aria-label="Facturas del cliente" tabindex="0">
                    <table class="tabla-lista">
                        <thead>
                            <tr><th scope="col">Número</th><th scope="col">Fecha</th><th scope="col" class="text-end">Subtotal</th><th scope="col" class="text-end">IVA</th><th scope="col" class="text-end">Total</th><th scope="col">Estado</th><th scope="col" class="acciones"><span class="visually-hidden">Acciones</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var f in facturas)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.NumeroFactura</td>
                                    <td>@f.FechaFactura.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@f.Subtotal.ToString("N2")</td>
                                    <td class="text-end">@f.IVA.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@f.Total.ToString("N2")</td>
                                    <td><span class="estado estado-@f.Estado.ToLowerInvariant()">@f.Estado</span></td>
                                    <td class="acciones">
                                        <a asp-controller="Facturas" asp-action="Imprimir" asp-route-id="@f.IdFactura" class="btn btn-sm btn-outline-primary btn-icono" title="Ver factura" aria-label="Ver factura">
                                            <i class="bi bi-printer" aria-hidden="true"></i><span class="etiqueta-accion">Factura</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
