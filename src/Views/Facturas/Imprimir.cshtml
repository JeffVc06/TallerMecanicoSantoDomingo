@model TallerMecanicoSantoDomingo.Services.FacturaCompleta
@{
    ViewData["Title"] = $"Imprimir {Model.Factura.NumeroFactura}";
    Layout = null;
    var f = Model.Factura;
    string nombreTaller = (string)(ViewBag.NombreTaller ?? "Taller Mecánico Santo Domingo");
    string direccionTaller = (string)(ViewBag.DireccionTaller ?? "");
    string telefonoTaller = (string)(ViewBag.TelefonoTaller ?? "");
    decimal ivaPorcentaje = (decimal)(ViewBag.PorcentajeIVA ?? 15m);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Factura @f.NumeroFactura — @nombreTaller</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="documento-factura">
    <main class="hoja">
        <div class="d-flex flex-wrap justify-content-end gap-2 sin-imprimir mb-3 no-print">
            <button onclick="window.print()" class="btn btn-naranja"><i class="bi bi-printer me-1" aria-hidden="true"></i> Imprimir / Guardar PDF</button>
            <a href="javascript:history.back()" class="btn btn-outline-secondary">Volver</a>
        </div>

        <article class="hoja-factura" aria-labelledby="titulo-factura">
            <header class="encabezado-factura d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <div class="nombre-taller">@nombreTaller</div>
                    <div class="texto-secundario">@direccionTaller</div>
                    <div class="texto-secundario">Tel. @telefonoTaller</div>
                </div>
                <div>
                    <h1 class="h5 fw-bold text-primary mb-1" id="titulo-factura">Factura @f.NumeroFactura</h1>
                    <div class="texto-secundario">Fecha @f.FechaFactura.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    @if (f.Estado == "Anulada")
                    {
                        <div class="anulada mt-1">Anulada</div>
                    }
                </div>
            </header>

            <div class="row g-3 mb-3">
                <div class="col-md-7">
                    <section class="caja-factura h-100">
                        <h2 class="h6 fw-bold text-primary mb-2">Datos del cliente</h2>
                        <div class="fw-semibold">@(f.Cliente != null ? f.Cliente.NombreCompleto : "—")</div>
                        <div>Cédula: @(f.Cliente?.Cedula ?? "—")</div>
                        @if (!string.IsNullOrWhiteSpace(f.RUC))
                        {
                            <div>RUC: @f.RUC</div>
                        }
                        <div>Tel. @(f.Cliente?.Telefono ?? "—")</div>
                        <div>@(f.Cliente?.Direccion ?? "—")</div>
                    </section>
                </div>
                <div class="col-md-5">
                    <section class="caja-factura h-100">
                        <h2 class="h6 fw-bold text-primary mb-2">Información de pago</h2>
                        <div><strong>Método</strong> @f.MetodoPago</div>
                        <div><strong>Servicios</strong> @Model.Detalles.Count</div>
                        @if (!string.IsNullOrEmpty(f.Notas))
                        {
                            <div><strong>Notas</strong> @f.Notas</div>
                        }
                    </section>
                </div>
            </div>

            <div class="tabla-envuelta mb-3" role="region" aria-label="Detalle de la factura" tabindex="0">
                <table class="tabla-lista">
                    <thead>
                        <tr>
                            <th scope="col">Servicio</th>
                            <th scope="col">Placa</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Descripción</th>
                            <th scope="col">Inicio</th>
                            <th scope="col" class="text-end">Subtotal (C$)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Detalles)
                        {
                            <tr>
                                <td>@d.IdServicio</td>
                                <td class="fw-semibold">@d.Placa</td>
                                <td>@d.TipoServicio</td>
                                <td>@d.Descripcion</td>
                                <td>@d.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@d.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="totales">
                <div class="fila"><span>Subtotal</span><strong>C$ @f.Subtotal.ToString("N2")</strong></div>
                <div class="fila"><span>IVA (@ivaPorcentaje%)</span><strong>C$ @f.IVA.ToString("N2")</strong></div>
                <div class="fila total"><span>Total a pagar</span><span>C$ @f.Total.ToString("N2")</span></div>
            </div>

            <p class="text-center texto-secundario mt-4 mb-0 small">Gracias por su preferencia.</p>
        </article>
    </main>
</body>
</html>
