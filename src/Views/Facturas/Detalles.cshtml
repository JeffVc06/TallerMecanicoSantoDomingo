@model TallerMecanicoSantoDomingo.Services.FacturaCompleta
@{
    ViewData["Title"] = $"Factura {Model.Factura.NumeroFactura}";
    var f = Model.Factura;
    bool emitida = f.Estado == "Emitida";
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-receipt me-2"></i>Factura @f.NumeroFactura</h1>
        <div class="ruta"><a asp-action="Index">Facturas</a> / Detalle de la factura</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Imprimir" asp-route-id="@f.IdFactura" class="btn btn-azul" target="_blank">
            <i class="bi bi-printer me-1"></i> Imprimir / PDF
        </a>
        @if (emitida)
        {
            <form asp-action="Anular" asp-route-id="@f.IdFactura" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="text" name="motivo" class="form-control" placeholder="Motivo de anulación (opcional)" maxlength="200" style="max-width:260px" />
                <button type="submit" class="btn btn-outline-danger"
                        data-confirmar="¿Anular la factura @f.NumeroFactura?">
                    <i class="bi bi-x-octagon me-1"></i> Anular
                </button>
            </form>
        }
    </div>
</div>

@if (f.Estado == "Anulada")
{
    <div class="alerta-error">
        <i class="bi bi-exclamation-triangle me-1"></i>
        <strong>Factura anulada.</strong>
    </div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-card-text me-1"></i> Datos de la factura</h2>
            <dl class="row mb-0" style="font-size:.9rem">
                <dt class="col-5 texto-secundario">Número</dt>
                <dd class="col-7 fw-semibold">@f.NumeroFactura</dd>
                <dt class="col-5 texto-secundario">Fecha</dt>
                <dd class="col-7">@f.FechaFactura.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                <dt class="col-5 texto-secundario">Estado</dt>
                <dd class="col-7"><span class="estado estado-@f.Estado.ToLowerInvariant()">@f.Estado</span></dd>
                <dt class="col-5 texto-secundario">Método de pago</dt>
                <dd class="col-7">@f.MetodoPago</dd>
            </dl>
            @if (!string.IsNullOrEmpty(f.Notas))
            {
                <div class="mt-2" style="font-size:.87rem"><strong>Notas:</strong> @f.Notas</div>
            }
        </div>

        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-person me-1"></i> Cliente</h2>
            @if (f.Cliente != null)
            {
                <div class="fw-semibold">@f.Cliente.NombreCompleto</div>
                <div class="texto-secundario" style="font-size:.85rem">RFC: @f.Cliente.RFC</div>
                <div class="texto-secundario" style="font-size:.85rem">Tel: @f.Cliente.Telefono</div>
                <div class="texto-secundario" style="font-size:.85rem">@f.Cliente.Direccion</div>
                <a asp-controller="Clientes" asp-action="Detalles" asp-route-id="@f.IdCliente" class="btn btn-sm btn-outline-primary mt-2">
                    <i class="bi bi-eye me-1"></i> Ficha del cliente
                </a>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-list-check me-1"></i> Servicios facturados (@Model.Detalles.Count)</h2>

            <div class="tabla-envuelta">
                <table class="tabla-lista">
                    <thead>
                        <tr>
                            <th>Servicio</th>
                            <th>Vehículo</th>
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th>Inicio</th>
                            <th class="text-end">Subtotal (C$)</th>
                            <th class="acciones"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Detalles)
                        {
                            <tr>
                                <td class="fw-semibold">#@d.IdServicio</td>
                                <td class="fw-semibold">@d.Placa</td>
                                <td><span class="estado tipo-@d.TipoServicio.ToLowerInvariant()">@d.TipoServicio</span></td>
                                <td style="max-width:200px">@d.Descripcion</td>
                                <td>@d.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@d.Subtotal.ToString("N2")</td>
                                <td class="acciones">
                                    <a asp-controller="Servicios" asp-action="Detalles" asp-route-id="@d.IdServicio" class="btn btn-sm btn-outline-primary btn-icono" title="Ver servicio">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="border rounded p-3 mt-3 bg-light" style="max-width:340px; margin-left:auto">
                <div class="d-flex justify-content-between"><span>Subtotal:</span><strong>C$ @f.Subtotal.ToString("N2")</strong></div>
                <div class="d-flex justify-content-between"><span>IVA:</span><strong>C$ @f.IVA.ToString("N2")</strong></div>
                <div class="d-flex justify-content-between fs-5"><span class="fw-bold text-primary">Total:</span><strong class="text-primary">C$ @f.Total.ToString("N2")</strong></div>
            </div>
        </div>
    </div>
</div>
