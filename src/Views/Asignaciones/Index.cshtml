@{
    ViewData["Title"] = "Asignaciones de personal";
    var serviciosAbiertos = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ServiciosAbiertos;
    var servicio = ViewBag.Servicio as TallerMecanicoSantoDomingo.Models.Servicio;
    var compatibles = ViewBag.Compatibles as List<TallerMecanicoSantoDomingo.Services.TrabajadorCarga>;
    var asignados = ViewBag.Asignados as List<TallerMecanicoSantoDomingo.Services.ItemAsignacion>;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-person-check me-2"></i>Asignación de personal</h1>
        <div class="ruta">Asignar trabajadores compatibles a los servicios abiertos</div>
    </div>
</div>

<div class="tarjeta mb-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-sm-9">
            <label class="form-label fw-semibold text-primary" style="font-size:.85rem">Seleccione el servicio abierto</label>
            <select name="idServicio" class="form-select" asp-items="serviciosAbiertos">
                <option value="">— Seleccione un servicio —</option>
            </select>
        </div>
        <div class="col-sm-3">
            <button type="submit" class="btn btn-azul w-100"><i class="bi bi-search me-1"></i> Consultar</button>
        </div>
    </form>
</div>

@if (servicio != null && compatibles != null && asignados != null)
{
    <div class="alerta-info">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Servicio #@servicio.IdServicio</strong> — @servicio.TipoServicio — @servicio.Vehiculo?.Placa
        (@servicio.Vehiculo?.Cliente?.NombreCompleto). Solo se muestran trabajadores del área compatible
        y no asignados previamente a este servicio.
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="tarjeta">
                <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-people me-1"></i> Trabajadores compatibles</h2>
                @if (compatibles.Count == 0)
                {
                    <div class="estado-vacio">
                        <i class="bi bi-person-x"></i>
                        <div>No hay trabajadores compatibles libres para este servicio.</div>
                        <div style="font-size:.83rem">Los del área ya están asignados o alcanzaron el límite de 2 servicios activos.</div>
                    </div>
                }
                else
                {
                    <div class="d-grid gap-2">
                        @foreach (var t in compatibles)
                        {
                            <div class="border rounded p-3 d-flex justify-content-between align-items-center @(t.Disponible ? "" : "opacity-75")">
                                <div>
                                    <div class="fw-semibold">@t.NombreCompleto</div>
                                    <div class="texto-secundario" style="font-size:.82rem">
                                        @t.Area — Carga actual: @t.ServiciosActivos de 2 activos
                                    </div>
                                </div>
                                @if (t.Disponible)
                                {
                                    <form asp-action="Asignar" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="IdServicio" value="@servicio.IdServicio" />
                                        <input type="hidden" name="IdTrabajador" value="@t.IdTrabajador" />
                                        <button type="submit" class="btn btn-sm btn-naranja">
                                            <i class="bi bi-person-check me-1"></i> Asignar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="estado estado-cancelado" title="Sin disponibilidad">Límite 2/2</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="tarjeta">
                <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-list-check me-1"></i> Trabajadores asignados a este servicio</h2>
                @if (asignados.Count == 0)
                {
                    <div class="estado-vacio">
                        <i class="bi bi-inbox"></i>
                        <div>Aún no hay trabajadores asignados.</div>
                    </div>
                }
                else
                {
                    <div class="tabla-envuelta">
                        <table class="tabla-lista">
                            <thead>
                                <tr><th>Trabajador</th><th>Área</th><th>Asignado el</th><th>Estado</th><th>Observaciones</th><th class="acciones"></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in asignados)
                                {
                                    <tr>
                                        <td class="fw-semibold">@a.NombreTrabajador</td>
                                        <td>@a.Area</td>
                                        <td>@a.FechaAsignacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="estado estado-@a.EstadoAsignacion.ToLowerInvariant()">@a.EstadoAsignacion</span></td>
                                        <td style="font-size:.82rem">@(a.Observaciones ?? "—")</td>
                                        <td class="acciones">
                                            @if (a.EstadoAsignacion == "Activo")
                                            {
                                                <form asp-action="Desasignar" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idTrabajador" value="@a.IdTrabajador" />
                                                    <input type="hidden" name="idServicio" value="@servicio.IdServicio" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-icono" title="Retirar"
                                                            data-confirmar="¿Retirar a @a.NombreTrabajador de este servicio?">
                                                        <i class="bi bi-person-dash"></i>
                                                    </button>
                                                </form>
                                            }
                                            <a asp-controller="Servicios" asp-action="Detalles" asp-route-id="@a.IdServicio" class="btn btn-sm btn-outline-primary btn-icono" title="Ver servicio">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}
