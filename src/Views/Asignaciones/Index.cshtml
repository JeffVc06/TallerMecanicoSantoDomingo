@{
    ViewData["Title"] = "Asignaciones de personal";
    var serviciosAbiertos = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ServiciosAbiertos;
    var servicio = ViewBag.Servicio as TallerMecanicoSantoDomingo.Models.Servicio;
    var compatibles = ViewBag.Compatibles as List<TallerMecanicoSantoDomingo.Services.TrabajadorCarga>;
    bool soloLectura = servicio != null && (servicio.Estado != "Abierto" || servicio.DetalleFacturas.Any(d => d.Factura?.Estado == "Emitida"));
    var asignados = ViewBag.Asignados as List<TallerMecanicoSantoDomingo.Services.ItemAsignacion>;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-person-check me-2" aria-hidden="true"></i>Asignación de personal</h1>
        <div class="ruta">Asignar trabajadores compatibles a los servicios abiertos</div>
    </div>
    @if (servicio != null)
    {
        <a asp-controller="Servicios" asp-action="Detalles" asp-route-id="@servicio.IdServicio" class="btn btn-outline-primary">Volver al servicio #@servicio.IdServicio</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(ViewData.ModelState["Observaciones"]?.AttemptedValue))
{
    <div class="alerta-info" role="status">Observaciones ingresadas: @ViewData.ModelState["Observaciones"]?.AttemptedValue</div>
}

<div class="tarjeta mb-3">
    <form asp-action="Index" method="get" class="filtros row g-2 align-items-end">
        <div class="col-sm-9">
            <label for="filtro-idservicio" class="form-label fw-semibold text-primary">Seleccione el servicio abierto</label>
            <select id="filtro-idservicio" name="idServicio" class="form-select" asp-items="serviciosAbiertos">
                <option value="">— Seleccione un servicio —</option>
            </select>
        </div>
        <div class="col-sm-3">
            <button type="submit" class="btn btn-azul w-100"><i class="bi bi-search me-1" aria-hidden="true"></i> Consultar</button>
        </div>
    </form>
</div>

@if (servicio != null && compatibles != null && asignados != null)
{
    <div class="alerta-info">
        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
        <strong>Servicio #@servicio.IdServicio</strong> — @servicio.TipoServicio — @servicio.Vehiculo?.Placa
        (@servicio.Vehiculo?.Cliente?.NombreCompleto). Solo se muestran trabajadores del área compatible
        que todavía no tengan una asignación activa aquí. El personal retirado puede volver a asignarse si tiene cupo.
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="tarjeta">
                <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-people me-1" aria-hidden="true"></i> Trabajadores compatibles</h2>
                @if (soloLectura)
                {
                    <div class="alerta-info">Este servicio se consulta como historial. Para asignar personal, seleccione un servicio abierto sin factura vigente.</div>
                }
                else if (compatibles.Count == 0)
                {
                    <div class="estado-vacio">
                        <i class="bi bi-person-x" aria-hidden="true"></i>
                        <div>No hay otro trabajador disponible para este servicio.</div>
                        <div style="font-size:.83rem">El personal del área ya está asignado, no está habilitado o tiene dos trabajos activos.</div>
                    </div>
                }
                else
                {
                    <div class="d-grid gap-2">
                        @foreach (var t in compatibles)
                        {
                            <div class="fila-personal @(t.Disponible ? "" : "fila-personal--limite")">
                                <div>
                                    <div class="fw-semibold">@t.NombreCompleto</div>
                                    <div class="texto-secundario" style="font-size:.82rem">
                                        @t.Area — Carga actual: @t.ServiciosActivos de 2 activos
                                    </div>
                                </div>
                                @if (t.Disponible)
                                {
                                    <form asp-action="Asignar" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="IdServicio" value="@servicio.IdServicio" />
                                        <input type="hidden" name="IdTrabajador" value="@t.IdTrabajador" />
                                        <button type="submit" class="btn btn-sm btn-naranja">
                                            <i class="bi bi-person-check me-1" aria-hidden="true"></i> Asignar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="estado estado-limite" title="Sin disponibilidad">Límite 2/2</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="tarjeta">
                <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-list-check me-1" aria-hidden="true"></i> Personal de este servicio</h2>
                <p class="form-text">Un trabajo abierto debe conservar al menos un responsable habilitado. Asigne el reemplazo antes de retirar al último.</p>
                @if (asignados.Count == 0)
                {
                    <div class="estado-vacio">
                        <i class="bi bi-inbox" aria-hidden="true"></i>
                        <div>Aún no hay trabajadores asignados.</div>
                    </div>
                }
                else
                {
                    <div class="tabla-envuelta" role="region" aria-label="Trabajadores asignados" tabindex="0">
                        <table class="tabla-lista">
                            <thead>
                                <tr><th scope="col">Trabajador</th><th scope="col">Área</th><th scope="col">Asignado el</th><th scope="col">Estado</th><th scope="col">Observaciones</th><th scope="col" class="acciones"><span class="visually-hidden">Acciones</span></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in asignados)
                                {
                                    <tr>
                                        <td class="fw-semibold">@a.NombreTrabajador</td>
                                        <td>@a.Area</td>
                                        <td>@a.FechaAsignacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="estado estado-@a.EstadoAsignacion.ToLowerInvariant()">@a.EstadoAsignacion</span></td>
                                        <td style="font-size:.82rem">@(a.Observaciones ?? "—")</td>
                                        <td class="acciones">
                                            @if (!soloLectura && a.EstadoAsignacion == "Activo")
                                            {
                                                var puedeRetirar = asignados.Any(otra => otra.IdTrabajador != a.IdTrabajador && otra.EstadoAsignacion == "Activo" && otra.Habilitado);
                                                <form asp-action="Desasignar" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idTrabajador" value="@a.IdTrabajador" />
                                                    <input type="hidden" name="idServicio" value="@servicio.IdServicio" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-icono" title="@(puedeRetirar ? "Retirar" : "Asigne primero un reemplazo habilitado")" disabled="@(!puedeRetirar)"
                                                            data-confirmar="¿Retirar a @a.NombreTrabajador de este servicio?" aria-label="Retirar">
                                                        <i class="bi bi-person-dash" aria-hidden="true"></i><span class="etiqueta-accion">Retirar</span>
                                                    </button>
                                                </form>
                                            }
                                            <a asp-controller="Servicios" asp-action="Detalles" asp-route-id="@a.IdServicio" class="btn btn-sm btn-outline-primary btn-icono" title="Ver servicio" aria-label="Ver servicio">
                                                <i class="bi bi-eye" aria-hidden="true"></i><span class="etiqueta-accion">Ver servicio</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}
