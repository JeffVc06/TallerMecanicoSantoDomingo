@model TallerMecanicoSantoDomingo.Services.ResultadoPaginado<TallerMecanicoSantoDomingo.Models.Producto>
@{
    ViewData["Title"] = "Productos y repuestos";
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-box-seam me-2"></i>Productos y repuestos</h1>
        <div class="ruta">Catálogo de repuestos y materiales utilizados en los servicios</div>
    </div>
    <a asp-action="Crear" class="btn btn-naranja"><i class="bi bi-plus-lg me-1"></i> Registrar producto</a>
</div>

<div class="tarjeta">
    <form asp-action="Index" method="get" data-busqueda class="row g-2 align-items-end mb-3">
        <input type="hidden" name="pagina" value="1" />
        <div class="col-sm-9">
            <label class="form-label fw-semibold text-primary" style="font-size:.85rem">Buscar por nombre o descripción</label>
            <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Ej.: filtro de aceite, barniz..." />
        </div>
        <div class="col-sm-3">
            <button type="submit" class="btn btn-azul w-100"><i class="bi bi-search me-1"></i> Buscar</button>
        </div>
    </form>

    @if (Model.Elementos.Count == 0)
    {
        <div class="estado-vacio">
            <i class="bi bi-box"></i>
            <div class="fw-semibold">No se encontraron productos</div>
            <div style="font-size:.85rem">Registre el primer repuesto o material del taller.</div>
        </div>
    }
    else
    {
        <div class="tabla-envuelta">
            <table class="tabla-lista">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Producto</th>
                        <th>Descripción</th>
                        <th class="text-end">Precio unitario (C$)</th>
                        <th class="text-end">Stock</th>
                        <th>Estado</th>
                        <th class="acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Elementos)
                    {
                        <tr>
                            <td class="fw-semibold">@p.IdProducto</td>
                            <td class="fw-semibold">@p.Nombre</td>
                            <td style="max-width:260px">@p.Descripcion</td>
                            <td class="text-end">@p.PrecioUnitario.ToString("N2")</td>
                            <td class="text-end">@p.Stock.ToString("0.###")</td>
                            <td><span class="estado @(p.Activo ? "estado-activo" : "estado-inactivo")">@(p.Activo ? "Activo" : "Desactivado")</span></td>
                            <td class="acciones">
                                <a asp-action="Detalles" asp-route-id="@p.IdProducto" class="btn btn-sm btn-outline-primary btn-icono" title="Ver historial de uso">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Editar" asp-route-id="@p.IdProducto" class="btn btn-sm btn-outline-secondary btn-icono" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="CambiarEstado" asp-route-id="@p.IdProducto" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="activo" value="@(!p.Activo)" />
                                    <button type="submit" class="btn btn-sm @(p.Activo ? "btn-outline-danger" : "btn-outline-success") btn-icono"
                                            title="@(p.Activo ? "Desactivar (no se podrá agregar a nuevos servicios)" : "Reactivar")"
                                            data-confirmar="¿Desea @(p.Activo ? "desactivar" : "reactivar") el producto @p.Nombre?">
                                        <i class="bi @(p.Activo ? "bi-box-seam" : "bi-boxes")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="texto-secundario" style="font-size:.83rem">
                    Página @Model.Pagina de @Model.TotalPaginas — @Model.TotalElementos registro(s)
                </span>
                <div class="paginacion">
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <a class="btn btn-sm @(p == Model.Pagina ? "actual" : "btn-outline-secondary")"
                           asp-action="Index" asp-route-pagina="@p" asp-route-buscar="@ViewBag.Buscar">@p</a>
                    }
                </div>
            </nav>
        }
    }
</div>
