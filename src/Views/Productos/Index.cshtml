@model TallerMecanicoSantoDomingo.Services.ResultadoPaginado<TallerMecanicoSantoDomingo.Models.Producto>
@{
    ViewData["Title"] = "Productos y repuestos";
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-box-seam me-2" aria-hidden="true"></i>Productos y repuestos</h1>
        <div class="ruta">Catálogo de repuestos y materiales utilizados en los servicios</div>
    </div>
    <a asp-action="Crear" class="btn btn-naranja"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Registrar producto</a>
</div>

<div class="tarjeta">
    <form asp-action="Index" method="get" data-busqueda class="filtros row g-2 align-items-end mb-3">
        <input type="hidden" name="pagina" value="1" />
        <div class="col-sm-9">
            <label for="filtro-buscar" class="form-label fw-semibold text-primary">Buscar por nombre o descripción</label>
            <input id="filtro-buscar" type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Ej.: filtro de aceite, barniz..." />
        </div>
        <div class="col-sm-3">
            <button type="submit" class="btn btn-azul w-100"><i class="bi bi-search me-1" aria-hidden="true"></i> Buscar</button>
        </div>
    </form>

    @if (Model.Elementos.Count == 0)
    {
        <div class="estado-vacio">
            <i class="bi bi-box" aria-hidden="true"></i>
            <div class="fw-semibold">No se encontraron productos</div>
            <div style="font-size:.85rem">Registre el primer repuesto o material del taller.</div>
        </div>
    }
    else
    {
        <div class="tabla-envuelta tabla-acciones-fijas" role="region" aria-label="Catálogo de repuestos" tabindex="0">
            <table class="tabla-lista tabla-adaptable" role="table">
                <thead role="rowgroup">
                    <tr role="row">
                        <th scope="col">#</th>
                        <th scope="col">Producto</th>
                        <th scope="col">Descripción</th>
                        <th scope="col" class="text-end">Precio unitario (C$)</th>
                        <th scope="col" class="text-end">Stock</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody role="rowgroup">
                    @foreach (var p in Model.Elementos)
                    {
                        <tr role="row">
                            <td role="cell" data-etiqueta="#" class="fw-semibold">@p.IdProducto</td>
                            <td role="cell" data-etiqueta="Producto" class="fw-semibold">@p.Nombre</td>
                            <td role="cell" data-etiqueta="Descripción" style="max-width:260px">@p.Descripcion</td>
                            <td role="cell" data-etiqueta="Precio unitario (C$)" class="text-end">@p.PrecioUnitario.ToString("N2")</td>
                            <td role="cell" data-etiqueta="Stock" class="text-end">@p.Stock.ToString("0.###")</td>
                            <td role="cell" data-etiqueta="Estado"><span class="estado @(p.Activo ? "estado-activo" : "estado-inactivo")">@(p.Activo ? "Activo" : "Desactivado")</span></td>
                            <td role="cell" data-etiqueta="Acciones" class="acciones">
                                <a asp-action="Detalles" asp-route-id="@p.IdProducto" class="btn btn-sm btn-outline-primary btn-icono" title="Ver historial de uso" aria-label="Ver historial de uso">
                                    <i class="bi bi-eye" aria-hidden="true"></i><span class="etiqueta-accion">Ver historial</span>
                                </a>
                                <a asp-action="Editar" asp-route-id="@p.IdProducto" class="btn btn-sm btn-outline-secondary btn-icono" title="Editar" aria-label="Editar">
                                    <i class="bi bi-pencil" aria-hidden="true"></i><span class="etiqueta-accion">Editar</span>
                                </a>
                                <form asp-action="CambiarEstado" asp-route-id="@p.IdProducto" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="activo" value="@(!p.Activo)" />
                                    <button type="submit" class="btn btn-sm @(p.Activo ? "btn-outline-danger" : "btn-outline-success") btn-icono"
                                            title="@(p.Activo ? "Desactivar (no se podrá agregar a nuevos servicios)" : "Reactivar")"
                                            data-confirmar="¿Desea @(p.Activo ? "desactivar" : "reactivar") el producto @p.Nombre?" aria-label="@(p.Activo ? "Desactivar (no se podrá agregar a nuevos servicios)" : "Reactivar")">
                                        <i class="bi @(p.Activo ? "bi-box-seam" : "bi-boxes")" aria-hidden="true"></i><span class="etiqueta-accion">@(p.Activo ? "Desactivar" : "Reactivar")</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="pie-listado" aria-label="Paginación">
                <span class="texto-secundario" style="font-size:.83rem">
                    Página @Model.Pagina de @Model.TotalPaginas — @Model.TotalElementos registro(s)
                </span>
                <div class="paginacion">
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <a class="btn btn-sm @(p == Model.Pagina ? "actual" : "btn-outline-secondary")"
                           aria-current="@(p == Model.Pagina ? "page" : null)" asp-action="Index" asp-route-pagina="@p" asp-route-buscar="@ViewBag.Buscar">@p</a>
                    }
                </div>
            </nav>
        }
    }
</div>
