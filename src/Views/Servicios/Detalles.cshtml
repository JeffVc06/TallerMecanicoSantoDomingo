@model TallerMecanicoSantoDomingo.Models.Servicio
@{
    ViewData["Title"] = $"Servicio #{Model.IdServicio} · {Model.Vehiculo?.Placa}";
    var asignaciones = (List<TallerMecanicoSantoDomingo.Services.ItemAsignacion>)ViewBag.Asignaciones;
    var compatibles = (List<TallerMecanicoSantoDomingo.Services.TrabajadorCarga>)ViewBag.TrabajadoresCompatibles;
    var facturaVigente = Model.DetalleFacturas.Select(d => d.Factura).FirstOrDefault(f => f?.Estado == "Emitida");
    bool abierto = Model.Estado == "Abierto" && facturaVigente == null;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-gear-wide-connected me-2" aria-hidden="true"></i>Servicio #@Model.IdServicio <span class="texto-secundario">· @Model.Vehiculo?.Placa</span></h1>
        <div class="ruta"><a asp-action="Index">Servicios</a> / Detalle del servicio</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (abierto)
        {
            <a asp-action="Editar" asp-route-id="@Model.IdServicio" class="btn btn-azul"><i class="bi bi-pencil me-1" aria-hidden="true"></i> Editar</a>
        }
        <a asp-controller="Vehiculos" asp-action="Detalles" asp-route-id="@Model.IdVehiculo" class="btn btn-outline-secondary">
            <i class="bi bi-car-front me-1" aria-hidden="true"></i> Ver vehículo
        </a>
    </div>
</div>

<div class="tarjeta" aria-label="Siguiente paso del trabajo">
    @if (facturaVigente != null)
    {
        <div class="fw-semibold">Este trabajo ya tiene una factura emitida.</div>
        <p class="form-text">El importe y los productos quedan protegidos. Consulte el documento para revisar el cobro.</p>
        <a asp-controller="Facturas" asp-action="Detalles" asp-route-id="@facturaVigente.IdFactura" class="btn btn-outline-primary">Ver factura @facturaVigente.NumeroFactura</a>
    }
    else if (abierto)
    {
        <div class="fw-semibold">Trabajo abierto · en atención</div>
        <p class="form-text mb-2">Revise el personal, registre los productos realmente utilizados y confirme el importe completo antes de finalizar.</p>
        <div class="d-flex flex-wrap gap-2">
            <a href="#personal-servicio" class="btn btn-sm btn-outline-primary">Personal asignado</a>
            <a href="#productos-servicio" class="btn btn-sm btn-outline-primary">Productos utilizados</a>
            <a href="#cierre-servicio" class="btn btn-sm btn-azul">Finalizar trabajo</a>
        </div>
    }
    else if (Model.Estado == "Finalizado")
    {
        <div class="fw-semibold">Trabajo finalizado</div>
        @if (Model.Vehiculo?.Cliente?.Activo == true)
        {
            <p class="form-text">Puede preparar la factura. Se mostrarán los trabajos finalizados del mismo cliente que aún estén pendientes de facturar.</p>
            <a asp-controller="Facturas" asp-action="Crear" asp-route-idCliente="@Model.Vehiculo.IdCliente" class="btn btn-naranja">Preparar factura</a>
        }
        else
        {
            <p class="form-text mb-0">El cliente debe estar activo para emitir una factura. Revise su ficha desde el vehículo.</p>
        }
    }
    else
    {
        <div class="fw-semibold">Consulte el historial de este trabajo.</div>
        <p class="form-text mb-0">Cancelar conserva los registros. Los productos utilizados no se devuelven automáticamente al inventario.</p>
    }
</div>

<div class="row g-3">
    <!-- Columna izquierda: datos del servicio -->
    <div class="col-lg-4">
        <div class="tarjeta">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-card-text me-1" aria-hidden="true"></i> Datos del servicio</h2>
            <dl class="row mb-0" style="font-size:.9rem">
                <dt class="col-5 texto-secundario">Vehículo</dt>
                <dd class="col-7 fw-semibold">@Model.Vehiculo?.Placa — @Model.Vehiculo?.Marca @Model.Vehiculo?.Modelo</dd>
                <dt class="col-5 texto-secundario">Propietario</dt>
                <dd class="col-7">@Model.Vehiculo?.Cliente?.NombreCompleto</dd>
                <dt class="col-5 texto-secundario">Tipo</dt>
                <dd class="col-7"><span class="estado tipo-@Model.TipoServicio.ToLowerInvariant()">@Model.TipoServicio</span></dd>
                <dt class="col-5 texto-secundario">Estado</dt>
                <dd class="col-7"><span class="estado estado-@Model.Estado.ToLowerInvariant()">@Model.Estado</span></dd>
                <dt class="col-5 texto-secundario">Inicio</dt>
                <dd class="col-7">@Model.FechaInicio.ToString("dd/MM/yyyy")</dd>
                <dt class="col-5 texto-secundario">Fin</dt>
                <dd class="col-7">@(Model.FechaFin?.ToString("dd/MM/yyyy") ?? (Model.Estado == "Cancelado" ? "No aplica" : Model.Estado == "Abierto" ? "Sin finalizar" : "Sin fecha registrada"))</dd>
                <dt class="col-5 texto-secundario">Monto</dt>
                <dd class="col-7 fw-semibold">C$ @Model.Total.ToString("N2")</dd>
            </dl>
            <div class="mt-3" style="font-size:.88rem"><strong>Descripción:</strong> @Model.Descripcion</div>
            @if (!string.IsNullOrEmpty(Model.DescripcionFalla))
            {
                <div class="mt-1" style="font-size:.88rem"><strong>Falla:</strong> @Model.DescripcionFalla</div>
            }
            @if (Model.TipoServicio == "Pintura")
            {
                @if (!string.IsNullOrEmpty(Model.TipoPintura))
                {
                    <div class="mt-1" style="font-size:.88rem"><strong>Tipo de pintura:</strong> @Model.TipoPintura</div>
                }
                @if (!string.IsNullOrEmpty(Model.Color))
                {
                    <div class="mt-1" style="font-size:.88rem"><strong>Color:</strong> @Model.Color</div>
                }
            }
        </div>

        @if (Model.DetalleFacturas.Any(df => df.Factura != null))
        {
            <div class="tarjeta">
                <h2 class="h6 fw-bold text-primary mb-2"><i class="bi bi-receipt me-1" aria-hidden="true"></i> Facturación</h2>
                @foreach (var df in Model.DetalleFacturas.Where(df => df.Factura != null))
                {
                    <div class="d-flex justify-content-between align-items-center" style="font-size:.87rem">
                        <span>@df.Factura!.NumeroFactura <span class="estado estado-@df.Factura.Estado.ToLowerInvariant()">@df.Factura.Estado</span></span>
                        <a asp-controller="Facturas" asp-action="Imprimir" asp-route-id="@df.Factura.IdFactura" class="btn btn-sm btn-outline-primary btn-icono" title="Ver factura" aria-label="Ver factura">
                            <i class="bi bi-printer" aria-hidden="true"></i><span class="etiqueta-accion">Factura</span>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Columna derecha: operación -->
    <div class="col-lg-8">
        <!-- Trabajadores asignados -->
        <div class="tarjeta" id="personal-servicio">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-person-badge me-1" aria-hidden="true"></i> Trabajadores asignados</h2>

            @if (asignaciones.Count == 0)
            {
                <div class="estado-vacio py-3" id="zona-vacia-asignados">
                    <i class="bi bi-person-x" aria-hidden="true"></i>
                    <div>Aún no hay trabajadores asignados a este servicio.</div>
                </div>
            }
            else
            {
                <div class="tabla-envuelta" role="region" aria-label="Trabajadores asignados" tabindex="0">
                    <table class="tabla-lista tabla-adaptable" role="table" id="tabla-asignados">
                        <thead role="rowgroup">
                            <tr role="row"><th scope="col">Trabajador</th><th scope="col">Área</th><th scope="col">Asignado el</th><th scope="col">Estado</th><th scope="col" class="acciones"><span class="visually-hidden">Acciones</span></th></tr>
                        </thead>
                        <tbody role="rowgroup">
                            @foreach (var a in asignaciones)
                            {
                                <tr role="row">
                                    <td role="cell" data-etiqueta="Trabajador" class="fw-semibold">@a.NombreTrabajador</td>
                                    <td role="cell" data-etiqueta="Área">@a.Area</td>
                                    <td role="cell" data-etiqueta="Asignado el">@a.FechaAsignacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td role="cell" data-etiqueta="Asignación"><span class="estado estado-@a.EstadoAsignacion.ToLowerInvariant()">@a.EstadoAsignacion</span></td>
                                    <td role="cell" data-etiqueta="Acciones" class="acciones">
                                        @if (abierto && a.EstadoAsignacion == "Activo")
                                        {
                                            var puedeRetirar = asignaciones.Any(otra => otra.IdTrabajador != a.IdTrabajador && otra.EstadoAsignacion == "Activo" && otra.Habilitado);
                                            <form asp-controller="Asignaciones" asp-action="Desasignar" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idTrabajador" value="@a.IdTrabajador" />
                                                <input type="hidden" name="idServicio" value="@Model.IdServicio" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-icono" title="@(puedeRetirar ? "Retirar del servicio" : "Asigne primero un reemplazo habilitado")" disabled="@(!puedeRetirar)"
                                                        data-confirmar="¿Retirar a @a.NombreTrabajador de este servicio?" aria-label="Retirar del servicio">
                                                    <i class="bi bi-person-dash" aria-hidden="true"></i><span class="etiqueta-accion">Retirar</span>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (abierto)
            {
                <div class="subformulario">
                    <h3>Agregar personal al trabajo</h3>
                    <p class="form-text">Para retirar al último responsable, primero asigne un reemplazo habilitado.</p>
                    <form asp-controller="Asignaciones" asp-action="Asignar" method="post" class="row g-2 align-items-end" id="formulario-asignacion">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdServicio" value="@Model.IdServicio" />
                        <div class="col-md-6">
                            <label for="selector-trabajador" class="form-label">Trabajadores del área: @Model.TipoServicio</label>
                            <select name="IdTrabajador" class="form-select" id="selector-trabajador" required>
                                <option value="">— Seleccione —</option>
                                @foreach (var t in compatibles)
                                {
                                    <option value="@t.IdTrabajador" selected="@(ViewData.ModelState["IdTrabajador"]?.AttemptedValue == t.IdTrabajador.ToString())" data-activos="@t.ServiciosActivos" data-disponible="@t.Disponible" disabled="@(!t.Disponible)">
                                        @t.NombreCompleto — @t.Area (@t.ServiciosActivos de 2 activos)
                                    </option>
                                }
                            </select>
                            <div class="form-text" id="aviso-carga" role="status"></div>
                        </div>
                        <div class="col-md-3">
                            <label for="observaciones-asignacion" class="form-label">Observaciones</label>
                            <input id="observaciones-asignacion" name="Observaciones" class="form-control" placeholder="Opcional" maxlength="200" value="@(ViewData.ModelState["Observaciones"]?.AttemptedValue)" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-naranja w-100" disabled="@(!compatibles.Any(t => t.Disponible))"><i class="bi bi-person-check me-1" aria-hidden="true"></i> Asignar</button>
                        </div>
                    </form>
                    @if (!compatibles.Any(t => t.Disponible))
                    {
                        <div class="alerta-info mt-2 mb-0" style="font-size:.85rem">
                            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                            No hay otro trabajador disponible para agregar a este servicio. El personal del área ya está asignado o no tiene cupo.
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Productos utilizados -->
        <div class="tarjeta" id="productos-servicio">
            <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-box-seam me-1" aria-hidden="true"></i> Productos utilizados</h2>

            @if (!Model.ProductosUtilizados.Any())
            {
                <div class="estado-vacio py-3">
                    <i class="bi bi-box" aria-hidden="true"></i>
                    <div>No se han registrado productos en este servicio.</div>
                </div>
            }
            else
            {
                <div class="tabla-envuelta" role="region" aria-label="Productos utilizados" tabindex="0">
                    <table class="tabla-lista tabla-adaptable" role="table">
                        <thead role="rowgroup">
                            <tr role="row"><th scope="col">Producto</th><th scope="col" class="text-end">Cantidad</th><th scope="col" class="text-end">Precio actual (C$)</th><th scope="col" class="text-end">Estimación actual (C$)</th><th scope="col" class="acciones"><span class="visually-hidden">Acciones</span></th></tr>
                        </thead>
                        <tbody role="rowgroup">
                            @foreach (var pu in Model.ProductosUtilizados.Where(pu => pu.Producto != null))
                            {
                                <tr role="row">
                                    <td role="cell" data-etiqueta="Producto" class="fw-semibold">@pu.Producto!.Nombre</td>
                                    <td role="cell" data-etiqueta="Cantidad" class="text-end">@pu.Cantidad.ToString("0.###")</td>
                                    <td role="cell" data-etiqueta="Precio actual" class="text-end">C$ @pu.Producto.PrecioUnitario.ToString("N2")</td>
                                    <td role="cell" data-etiqueta="Estimación actual" class="text-end">C$ @((pu.Cantidad * pu.Producto.PrecioUnitario).ToString("N2"))</td>
                                    <td role="cell" data-etiqueta="Acciones" class="acciones">
                                        @if (abierto)
                                        {
                                            <form asp-action="ActualizarProducto" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idProducto" value="@pu.IdProducto" />
                                                <input type="hidden" name="idServicio" value="@Model.IdServicio" />
                                                <input type="number" name="cantidad" value="@(ViewData.ModelState["idProducto"]?.AttemptedValue == pu.IdProducto.ToString() ? ViewData.ModelState["cantidad"]?.AttemptedValue ?? pu.Cantidad.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) : pu.Cantidad.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))" step="0.001" min="0.001" class="form-control form-control-sm d-inline-block" style="width:100px" aria-label="Cantidad de @pu.Producto.Nombre" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary btn-icono" title="Actualizar cantidad" aria-label="Actualizar cantidad"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="etiqueta-accion">Actualizar</span></button>
                                            </form>
                                            <form asp-action="QuitarProducto" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idProducto" value="@pu.IdProducto" />
                                                <input type="hidden" name="idServicio" value="@Model.IdServicio" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-icono" title="Quitar producto"
                                                        data-confirmar="¿Quitar @pu.Producto.Nombre de este servicio?" aria-label="Quitar producto">
                                                    <i class="bi bi-trash" aria-hidden="true"></i><span class="etiqueta-accion">Quitar</span>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (abierto)
            {
                <div class="subformulario">
                    <h3>Agregar producto al servicio</h3>
                    <form asp-action="AgregarProducto" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdServicio" value="@Model.IdServicio" />
                        <div class="col-md-6">
                            <label for="producto-utilizado" class="form-label">Producto</label>
                            <select id="producto-utilizado" name="IdProducto" class="form-select" required>
                                <option value="">— Seleccione un producto activo —</option>
                                @foreach (var p in (List<TallerMecanicoSantoDomingo.Models.Producto>)ViewBag.ProductosActivos)
                                {
                                    <option value="@p.IdProducto" selected="@(ViewData.ModelState["IdProducto"]?.AttemptedValue == p.IdProducto.ToString())">@p.Nombre — C$ @p.PrecioUnitario.ToString("N2") (stock: @p.Stock.ToString("0.###"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="cantidad-utilizada" class="form-label">Cantidad</label>
                            <input id="cantidad-utilizada" type="number" name="Cantidad" class="form-control" step="0.001" min="0.001" value="@(ViewData.ModelState["Cantidad"]?.AttemptedValue ?? "1")" placeholder="Cantidad" required />
                            <div class="form-text">La cantidad debe ser mayor que cero.</div>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-naranja w-100"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Agregar</button>
                        </div>
                    </form>
                </div>
            }
        </div>

        <p class="form-text">Los precios de productos mostrados son actuales y orientativos; no representan el precio histórico aplicado ni modifican los importes guardados de las facturas.</p>

        <!-- Estado del servicio -->
        @if (abierto)
        {
            <div class="tarjeta" id="cierre-servicio">
                <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-send-check me-1" aria-hidden="true"></i> Cerrar el trabajo</h2>
                <p class="form-text">Finalice cuando el trabajo esté terminado y el importe revisado. Cancelar cierra las asignaciones, pero conserva los productos consumidos.</p>
                <div class="row g-3">
                    <div class="col-md-7">
                        <form asp-action="Finalizar" method="post" class="formulario">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="IdServicio" value="@Model.IdServicio" />
                            <label for="fecha-finalizacion" class="form-label">Fecha de finalización</label>
                            <div class="d-grid gap-2">
                                <input id="fecha-finalizacion" type="date" name="FechaFin" class="form-control" value="@(ViewData.ModelState["FechaFin"]?.AttemptedValue ?? DateTime.Today.ToString("yyyy-MM-dd"))" required />
                                <button type="submit" class="btn btn-azul" data-confirmar="¿Finalizar este servicio? Se cerrarán sus asignaciones de personal.">
                                    <i class="bi bi-check2-circle me-1" aria-hidden="true"></i> Finalizar trabajo
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-5">
                        <form asp-action="Cancelar" method="post" class="formulario">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="IdServicio" value="@Model.IdServicio" />
                            <label for="filtro-motivo" class="form-label">Cancelar servicio</label>
                            <input id="filtro-motivo" type="text" name="Motivo" value="@(ViewData.ModelState["Motivo"]?.AttemptedValue)" class="form-control mb-2" placeholder="Motivo (opcional)" maxlength="200" />
                            <button type="submit" class="btn btn-outline-danger w-100"
                                    data-confirmar="¿Cancelar este servicio? Se cerrarán las asignaciones. Los productos registrados seguirán descontados del inventario.">
                                <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Cancelar trabajo
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Aviso de capacidad del trabajador seleccionado (información consultada al servidor en el listado).
        (function () {
            const selector = document.getElementById('selector-trabajador');
            const aviso = document.getElementById('aviso-carga');
            if (!selector || !aviso) return;
            selector.addEventListener('change', function () {
                const opcion = selector.selectedOptions[0];
                if (!opcion || !opcion.value) { aviso.textContent = ''; return; }
                const activos = opcion.getAttribute('data-activos');
                const disponible = opcion.getAttribute('data-disponible') === 'True';
                if (!disponible) {
                    aviso.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Este trabajador ya tiene ' + activos + ' de 2 servicios activos. No está disponible para otra asignación.</span>';
                } else {
                    aviso.innerHTML = '<span class="text-success"><i class="bi bi-check-circle" aria-hidden="true"></i> Carga actual: ' + activos + ' de 2 servicios activos.</span>';
                }
            });
        })();
    </script>
}
