@model TallerMecanicoSantoDomingo.ViewModels.ServicioFormViewModel
@{
    ViewData["Title"] = "Registrar servicio";
    var trabajadores = (List<TallerMecanicoSantoDomingo.Services.TrabajadorCarga>)ViewBag.TrabajadoresIniciales;
    var vehiculos = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Vehiculos;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-gear-wide-connected me-2" aria-hidden="true"></i>Registrar servicio</h1>
        <div class="ruta"><a asp-action="Index">Servicios</a> / Nuevo servicio</div>
    </div>
</div>

@if (vehiculos.Count == 0)
{
    <div class="alerta-advertencia" role="status">
        No hay vehículos disponibles. Registre o reactive un vehículo y su cliente antes de abrir un trabajo.
        <a asp-controller="Vehiculos" asp-action="Index">Ver vehículos</a>
    </div>
}

<div class="tarjeta formulario-tarjeta">
    <form asp-action="Crear" method="post" class="formulario" data-formulario-servicio>
        <div asp-validation-summary="ModelOnly" class="alerta-error" role="alert"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="IdVehiculo" class="form-label"></label>
                <select asp-for="IdVehiculo" class="form-select" asp-items="vehiculos">
                    <option value="">— Seleccione el vehículo —</option>
                </select>
                <span asp-validation-for="IdVehiculo" class="text-danger"></span>
                <div class="form-text">Seleccione el vehículo que recibirá el servicio.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="TipoServicio" for="campo-tipo" class="form-label"></label>
                <select asp-for="TipoServicio" class="form-select" id="campo-tipo">
                    <option value="Mantenimiento">Mantenimiento mecánico</option>
                    <option value="Pintura">Trabajo de pintura</option>
                </select>
                <span asp-validation-for="TipoServicio" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FechaInicio" class="form-label"></label>
                <input asp-for="FechaInicio" class="form-control" type="date" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="IdTrabajadorInicial" class="form-label"></label>
                <select asp-for="IdTrabajadorInicial" class="form-select" aria-describedby="ayuda-trabajador-inicial" required>
                    <option value="">— Elija al responsable —</option>
                    @foreach (var t in trabajadores)
                    {
                        <option value="@t.IdTrabajador" data-tipo="@(t.Area == "Pintura" ? "Pintura" : "Mantenimiento")" selected="@(Model.IdTrabajadorInicial == t.IdTrabajador)">@t.NombreCompleto — @t.Area (@t.ServiciosActivos de 2 trabajos activos)</option>
                    }
                </select>
                <span asp-validation-for="IdTrabajadorInicial" class="text-danger"></span>
                <div class="form-text" id="ayuda-trabajador-inicial">El responsable debe pertenecer al área elegida y tener menos de dos trabajos activos. Después puede agregar más personal.</div>
            </div>
            <div class="col-12 alerta-advertencia d-none" id="aviso-sin-personal" role="status">
                No hay personal disponible para el área elegida. Revise las asignaciones activas o registre un trabajador antes de abrir el servicio.
                <a asp-controller="Trabajadores" asp-action="Index">Ver personal del taller</a>
            </div>
            <div class="col-12"><h2 class="formulario-seccion">Detalle del trabajo</h2></div>
            <div class="col-12">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Detalle del trabajo a realizar"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="col-12 div-mantenimiento">
                <label asp-for="DescripcionFalla" class="form-label"></label>
                <textarea asp-for="DescripcionFalla" class="form-control" rows="2" placeholder="Síntomas reportados por el cliente"></textarea>
                <span asp-validation-for="DescripcionFalla" class="text-danger"></span>
            </div>
            <div class="col-md-6 div-pintura d-none">
                <label asp-for="TipoPintura" class="form-label"></label>
                <input asp-for="TipoPintura" class="form-control" placeholder="Base de agua, base solvente, barniz..." />
                <span asp-validation-for="TipoPintura" class="text-danger"></span>
            </div>
            <div class="col-md-6 div-pintura d-none">
                <label asp-for="Color" class="form-label"></label>
                <input asp-for="Color" class="form-control" placeholder="Blanco perla, rojo, azul..." />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Total" class="form-label"></label>
                <input asp-for="Total" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                <span asp-validation-for="Total" class="text-danger"></span>
                <div class="form-text">Importe total a cobrar por el trabajo, incluyendo los productos que correspondan. Los consumos no se suman automáticamente a este importe.</div>
            </div>
        </div>

        <div class="alerta-info mt-3" style="font-size:.85rem">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
            Al guardar se abre el trabajo con su responsable. Después podrá registrar los productos utilizados y agregar más personal.
        </div>

        <div class="acciones-formulario">
            <button type="submit" class="btn btn-naranja"><i class="bi bi-save me-1" aria-hidden="true"></i> Abrir servicio</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
