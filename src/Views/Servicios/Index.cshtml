@model TallerMecanicoSantoDomingo.Services.ResultadoPaginado<TallerMecanicoSantoDomingo.Models.Servicio>
@{
    ViewData["Title"] = "Servicios";
    var tipos = (IReadOnlyList<string>)ViewBag.Tipos;
    var estados = (IReadOnlyList<string>)ViewBag.Estados;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-gear-wide-connected me-2" aria-hidden="true"></i>Servicios</h1>
        <div class="ruta">Mantenimientos mecánicos y trabajos de pintura</div>
    </div>
    <a asp-action="Crear" class="btn btn-naranja"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Registrar servicio</a>
</div>

<div class="tarjeta">
    <form asp-action="Index" method="get" data-busqueda class="filtros row g-2 align-items-end mb-3">
        <input type="hidden" name="pagina" value="1" />
        <div class="col-md-4">
            <label for="filtro-buscar" class="form-label fw-semibold text-primary">Buscar</label>
            <input id="filtro-buscar" type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Descripción, placa o cliente..." />
        </div>
        <div class="col-md-3">
            <label for="filtro-tipo" class="form-label fw-semibold text-primary">Tipo</label>
            <select id="filtro-tipo" name="tipo" class="form-select">
                <option value="">Todos</option>
                @foreach (var t in tipos)
                {
                    <option value="@t" selected="@(ViewBag.Tipo as string == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="filtro-estado" class="form-label fw-semibold text-primary">Estado</label>
            <select id="filtro-estado" name="estado" class="form-select">
                <option value="">Todos</option>
                @foreach (var e in estados)
                {
                    <option value="@e" selected="@(ViewBag.Estado as string == e)">@e</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-azul w-100"><i class="bi bi-search me-1" aria-hidden="true"></i> Filtrar</button>
        </div>
    </form>

    @if (Model.Elementos.Count == 0)
    {
        <div class="estado-vacio">
            <i class="bi bi-gear" aria-hidden="true"></i>
            <div class="fw-semibold">No se encontraron servicios</div>
            <div style="font-size:.85rem">Registre un servicio o ajuste los filtros de búsqueda.</div>
        </div>
    }
    else
    {
        <div class="tabla-envuelta tabla-acciones-fijas" role="region" aria-label="Listado de servicios" tabindex="0">
            <table class="tabla-lista tabla-adaptable" role="table">
                <thead role="rowgroup">
                    <tr role="row">
                        <th scope="col">#</th>
                        <th scope="col">Fecha inicio</th>
                        <th scope="col">Vehículo</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Personal</th>
                        <th scope="col" class="text-end">Importe (C$)</th>
                        <th scope="col" class="acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody role="rowgroup">
                    @foreach (var s in Model.Elementos)
                    {
                        var equipo = s.DetalleServicios
                            .Where(d => s.Estado != "Abierto" || d.Estado == "Activo")
                            .Where(d => d.Trabajador != null)
                            .OrderBy(d => d.Trabajador!.Apellido).ThenBy(d => d.IdTrabajador)
                            .Select(d => d.Trabajador!.NombreCompleto).ToList();
                        <tr role="row">
                            <td role="cell" data-etiqueta="#" class="fw-semibold">@s.IdServicio</td>
                            <td role="cell" data-etiqueta="Fecha inicio">@s.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td role="cell" data-etiqueta="Vehículo" class="fw-semibold">@s.Vehiculo?.Placa</td>
                            <td role="cell" data-etiqueta="Cliente">@s.Vehiculo?.Cliente?.NombreCompleto</td>
                            <td role="cell" data-etiqueta="Tipo"><span class="estado tipo-@s.TipoServicio.ToLowerInvariant()">@s.TipoServicio</span></td>
                            <td role="cell" data-etiqueta="Descripción" style="max-width:220px">@s.Descripcion</td>
                            <td role="cell" data-etiqueta="Estado"><span class="estado estado-@s.Estado.ToLowerInvariant()">@s.Estado</span></td>
                            <td role="cell" data-etiqueta="Personal">
                                @if (equipo.Count == 0)
                                {
                                    <span class="@(s.Estado == "Abierto" ? "text-danger" : "texto-secundario")">Sin personal registrado</span>
                                }
                                else
                                {
                                    <span>@string.Join(", ", equipo)</span>
                                    @if (s.Estado != "Abierto")
                                    {
                                        <div class="form-text m-0">Personal del historial</div>
                                    }
                                }
                            </td>
                            <td role="cell" data-etiqueta="Importe (C$)" class="text-end">@s.Total.ToString("N2")</td>
                            <td role="cell" data-etiqueta="Acciones" class="acciones">
                                <a asp-action="Detalles" asp-route-id="@s.IdServicio" class="btn btn-sm btn-outline-primary btn-icono" title="Ver trabajo y personal" aria-label="Ver trabajo y personal">
                                    <i class="bi bi-eye" aria-hidden="true"></i><span class="etiqueta-accion">Ver trabajo</span>
                                </a>
                                @if (s.Estado == "Abierto")
                                {
                                    <a asp-action="Editar" asp-route-id="@s.IdServicio" class="btn btn-sm btn-outline-secondary btn-icono" title="Editar" aria-label="Editar">
                                        <i class="bi bi-pencil" aria-hidden="true"></i><span class="etiqueta-accion">Editar</span>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="pie-listado" aria-label="Paginación">
                <span class="texto-secundario" style="font-size:.83rem">
                    Página @Model.Pagina de @Model.TotalPaginas — @Model.TotalElementos registro(s)
                </span>
                <div class="paginacion">
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <a class="btn btn-sm @(p == Model.Pagina ? "actual" : "btn-outline-secondary")"
                           aria-current="@(p == Model.Pagina ? "page" : null)" asp-action="Index" asp-route-pagina="@p" asp-route-buscar="@ViewBag.Buscar"
                           asp-route-tipo="@ViewBag.Tipo" asp-route-estado="@ViewBag.Estado">@p</a>
                    }
                </div>
            </nav>
        }
    }
</div>
