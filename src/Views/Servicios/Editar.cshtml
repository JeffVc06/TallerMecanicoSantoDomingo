@model TallerMecanicoSantoDomingo.ViewModels.ServicioFormViewModel
@{
    ViewData["Title"] = $"Editar servicio #{Model.IdServicio}";
    var vehiculos = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Vehiculos;
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Editar servicio #@Model.IdServicio</h1>
        <div class="ruta"><a asp-action="Index">Servicios</a> / Editar</div>
    </div>
</div>

<div class="alerta-info" style="font-size:.85rem">
    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
    Puede corregir la descripción, la falla, las fechas y el importe de un servicio abierto sin factura. El vehículo y el tipo se conservan para mantener su historial.
</div>

<div class="tarjeta formulario-tarjeta">
    <form asp-action="Editar" method="post" class="formulario" data-formulario-servicio>
        <input type="hidden" asp-for="IdServicio" />
        <div asp-validation-summary="ModelOnly" class="alerta-error" role="alert"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="IdVehiculo" class="form-label"></label>
                <input type="hidden" asp-for="IdVehiculo" id="vehiculo-actual" />
                <select asp-for="IdVehiculo" class="form-select" asp-items="vehiculos" disabled>
                    <option value="">— Seleccione el vehículo —</option>
                </select>
                <span asp-validation-for="IdVehiculo" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TipoServicio" for="campo-tipo" class="form-label"></label>
                <input type="hidden" asp-for="TipoServicio" id="tipo-servicio-actual" />
                <select asp-for="TipoServicio" class="form-select" id="campo-tipo" disabled>
                    <option value="Mantenimiento">Mantenimiento mecánico</option>
                    <option value="Pintura">Trabajo de pintura</option>
                </select>
                <span asp-validation-for="TipoServicio" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FechaInicio" class="form-label"></label>
                <input asp-for="FechaInicio" class="form-control" type="date" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            <div class="col-12"><h2 class="formulario-seccion">Detalle del trabajo</h2></div>
            <div class="col-12">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="col-12 div-mantenimiento">
                <label asp-for="DescripcionFalla" class="form-label"></label>
                <textarea asp-for="DescripcionFalla" class="form-control" rows="2"></textarea>
                <span asp-validation-for="DescripcionFalla" class="text-danger"></span>
            </div>
            <div class="col-md-6 div-pintura d-none">
                <label asp-for="TipoPintura" class="form-label"></label>
                <input asp-for="TipoPintura" class="form-control" />
                <span asp-validation-for="TipoPintura" class="text-danger"></span>
            </div>
            <div class="col-md-6 div-pintura d-none">
                <label asp-for="Color" class="form-label"></label>
                <input asp-for="Color" class="form-control" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Total" class="form-label"></label>
                <input asp-for="Total" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Total" class="text-danger"></span>
                <div class="form-text">Importe total del trabajo: incluya los productos que correspondan. El consumo no se suma automáticamente.</div>
            </div>
        </div>

        <div class="acciones-formulario">
            <button type="submit" class="btn btn-azul"><i class="bi bi-save me-1" aria-hidden="true"></i> Guardar cambios</button>
            <a asp-action="Detalles" asp-route-id="@Model.IdServicio" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
