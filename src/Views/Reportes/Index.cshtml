@{
    ViewData["Title"] = "Reportes";
    var servicios = ViewBag.Servicios as List<TallerMecanicoSantoDomingo.Services.FilaServicioReporte> ?? new();
    var facturas = ViewBag.Facturas as List<TallerMecanicoSantoDomingo.Services.FilaFacturaReporte> ?? new();
    var montos = ViewBag.Montos as List<TallerMecanicoSantoDomingo.Services.FilaMontoMensual> ?? new();
    var carga = ViewBag.Carga as List<TallerMecanicoSantoDomingo.Services.FilaTrabajadorReporte> ?? new();
    var productos = ViewBag.Productos as List<TallerMecanicoSantoDomingo.Services.FilaProductoReporte> ?? new();
    var desde = (DateOnly)ViewBag.Desde;
    var hasta = (DateOnly)ViewBag.Hasta;
    decimal totalFacturado = montos.Sum(m => m.Total);
}

<div class="encabezado-pagina">
    <div>
        <h1><i class="bi bi-graph-up me-2" aria-hidden="true"></i>Reportes</h1>
        <div class="ruta">Reportes del @desde.ToString("dd/MM/yyyy") al @hasta.ToString("dd/MM/yyyy")</div>
    </div>
</div>

<!-- Tarjetas de navegación a cada reporte -->
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <a asp-action="Servicios" class="text-decoration-none">
            <div class="tarjeta tarjeta-indicador h-100">
                <div class="icono fondo-azul"><i class="bi bi-gear-wide-connected" aria-hidden="true"></i></div>
                <div><div class="dato">@servicios.Count</div><div class="etiqueta">Servicios en el período</div></div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-action="Facturas" class="text-decoration-none">
            <div class="tarjeta tarjeta-indicador h-100">
                <div class="icono fondo-naranja"><i class="bi bi-receipt" aria-hidden="true"></i></div>
                <div><div class="dato">@facturas.Count</div><div class="etiqueta">Facturas emitidas</div></div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-action="Facturas" class="text-decoration-none">
            <div class="tarjeta tarjeta-indicador h-100">
                <div class="icono fondo-verde"><i class="bi bi-cash-stack" aria-hidden="true"></i></div>
                <div><div class="dato">C$ @totalFacturado.ToString("N2")</div><div class="etiqueta">Total facturado (incluye IVA)</div></div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-action="Trabajadores" class="text-decoration-none">
            <div class="tarjeta tarjeta-indicador h-100">
                <div class="icono fondo-rojo"><i class="bi bi-people" aria-hidden="true"></i></div>
                <div><div class="dato">@(carga.Sum(c => c.AsignacionesActivas))</div><div class="etiqueta">Asignaciones activas hoy</div></div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="tarjeta">
            <div class="cabecera-reporte">
                <h2 class="h6 fw-bold text-primary mb-0"><i class="bi bi-gear me-1" aria-hidden="true"></i> Servicios recientes del período</h2>
                <a asp-action="Servicios" class="btn btn-sm btn-outline-primary">Ver reporte completo</a>
            </div>
            @if (servicios.Count == 0)
            {
                <div class="estado-vacio py-3"><i class="bi bi-inbox" aria-hidden="true"></i><div>No hay servicios en este período.</div></div>
            }
            else
            {
                <div class="tabla-envuelta" role="region" aria-label="Servicios recientes del período" tabindex="0">
                    <table class="tabla-lista">
                        <thead><tr><th scope="col">#</th><th scope="col">Placa</th><th scope="col">Cliente</th><th scope="col">Tipo</th><th scope="col">Estado</th><th scope="col" class="text-end">Total</th></tr></thead>
                        <tbody>
                            @foreach (var s in servicios.Take(8))
                            {
                                <tr>
                                    <td class="fw-semibold">@s.IdServicio</td>
                                    <td class="fw-semibold">@s.Placa</td>
                                    <td>@s.Cliente</td>
                                    <td><span class="estado tipo-@s.TipoServicio.ToLowerInvariant()">@s.TipoServicio</span></td>
                                    <td><span class="estado estado-@s.Estado.ToLowerInvariant()">@s.Estado</span></td>
                                    <td class="text-end">@s.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="tarjeta">
            <div class="cabecera-reporte">
                <h2 class="h6 fw-bold text-primary mb-0"><i class="bi bi-box-seam me-1" aria-hidden="true"></i> Productos más utilizados</h2>
                <a asp-action="Productos" class="btn btn-sm btn-outline-primary">Ver reporte completo</a>
            </div>
            @if (productos.Count == 0)
            {
                <div class="estado-vacio py-3"><i class="bi bi-box" aria-hidden="true"></i><div>No hay uso de productos en este período.</div></div>
            }
            else
            {
                <div class="tabla-envuelta" role="region" aria-label="Productos más utilizados" tabindex="0">
                    <table class="tabla-lista">
                        <thead><tr><th scope="col">Producto</th><th scope="col" class="text-end">Cantidad</th><th scope="col" class="text-end">Usos</th><th scope="col" class="text-end">Monto estimado</th></tr></thead>
                        <tbody>
                            @foreach (var p in productos.Take(8))
                            {
                                <tr>
                                    <td class="fw-semibold">@p.Producto</td>
                                    <td class="text-end">@p.CantidadTotal.ToString("0.###")</td>
                                    <td class="text-end">@p.VecesUtilizado</td>
                                    <td class="text-end">@(p.MontoEstimado?.ToString("N2") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Índice de reportes disponibles -->
<div class="tarjeta mt-3">
    <h2 class="h6 fw-bold text-primary mb-3"><i class="bi bi-folder2-open me-1" aria-hidden="true"></i> Reportes disponibles</h2>
    <div class="row g-2">
        <div class="col-md-6 col-xl-4">
            <a asp-action="Servicios" class="reporte-enlace">
                <i class="bi bi-gear-wide-connected" aria-hidden="true"></i> Servicios por período (tipo, estado, cliente y trabajador)
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a asp-action="Vehiculos" class="reporte-enlace">
                <i class="bi bi-car-front" aria-hidden="true"></i> Servicios por vehículo
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a asp-action="Cliente" class="reporte-enlace">
                <i class="bi bi-person-vcard" aria-hidden="true"></i> Historial por cliente
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a asp-action="Trabajadores" class="reporte-enlace">
                <i class="bi bi-people" aria-hidden="true"></i> Carga y trabajos por trabajador
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a asp-action="Facturas" class="reporte-enlace">
                <i class="bi bi-receipt" aria-hidden="true"></i> Facturación por período (subtotal, IVA y total)
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a asp-action="Productos" class="reporte-enlace">
                <i class="bi bi-box-seam" aria-hidden="true"></i> Productos más utilizados
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </div>
    </div>
    <div class="form-text mt-2">
        Puede exportar los reportes a CSV o imprimirlos.
    </div>
</div>
