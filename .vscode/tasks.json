{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/src",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5080"
        }
      },
      "problemMatcher": "$msCompile",
      "detail": "Ejecuta la aplicación y actualiza los cambios al guardar."
    },
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/TallerMecanicoSantoDomingo.csproj",
        "--configuration",
        "Debug",
        "--output",
        "${workspaceFolder}/.vscode/build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "detail": "Compila el proyecto principal"
    },
    {
      "label": "build:release",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/TallerMecanicoSantoDomingo.csproj",
        "--configuration",
        "Release",
        "--output",
        "${workspaceFolder}/publish"
      ],
      "group": "build",
      "detail": "Publica en carpeta publish/"
    },
    {
      "label": "db:apply-schema",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "localhost",
        "-E",
        "-C",
        "-d",
        "TallerMecanicoSantoDomingo",
        "-i",
        "${workspaceFolder}/database/TallerMecanicoSantoDomingo.sql",
        "-b",
        "-f",
        "65001"
      ],
      "group": "none",
      "detail": "Aplica esquema SQL (requiere SQL Server corriendo)"
    },
    {
      "label": "db:seed-demo",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "localhost",
        "-E",
        "-C",
        "-d",
        "TallerMecanicoSantoDomingo",
        "-i",
        "${workspaceFolder}/database/DatosDemostracion.sql",
        "-b",
        "-f",
        "65001"
      ],
      "group": "none",
      "detail": "Carga datos de demostración"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/TallerMecanicoSantoDomingo.Tests.csproj",
        "--no-build",
        "--verbosity",
        "normal"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "detail": "Ejecuta todas las pruebas (unitarias + integración)"
    },
    {
      "label": "test:watch",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "watch",
        "test",
        "${workspaceFolder}/tests/TallerMecanicoSantoDomingo.Tests.csproj"
      ],
      "group": "test",
      "detail": "Ejecuta tests en modo watch (recompila al guardar)"
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/src/TallerMecanicoSantoDomingo.csproj"
      ],
      "group": "none",
      "detail": "Limpia bin/obj"
    }
  ]
}
