{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Launch TallerMecanicoSantoDomingo",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/TallerMecanicoSantoDomingo/bin/Debug/net10.0/TallerMecanicoSantoDomingo.dll",
      "args": ["--urls", "http://localhost:5080"],
      "cwd": "${workspaceFolder}/src/TallerMecanicoSantoDomingo",
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/TallerMecanicoSantoDomingo/Views"
      }
    },
    {
      "name": "🧪 Run Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/TallerMecanicoSantoDomingo.Tests/TallerMecanicoSantoDomingo.Tests.csproj",
        "--no-build",
        "--logger:console;verbosity=normal"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
